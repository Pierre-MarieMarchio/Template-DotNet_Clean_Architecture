root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
charset = utf-8-bom

[*.cs]
indent_size = 4
charset = utf-8-bom

#### Language conventions ####

csharp_style_namespace_declarations = file_scoped:error
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

csharp_prefer_braces = when_multiline:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = when_on_single_line:suggestion

dotnet_style_readonly_field = true:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_predefined_type_for_locals_parameters_members = true:warning

csharp_style_prefer_primary_constructors = false:suggestion
csharp_style_throw_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_null_propagation = true:warning
dotnet_style_coalesce_expression = true:warning

# Unused code must not accumulate silently. Reporting an unused using during a build needs
# GenerateDocumentationFile, which Directory.Build.props turns on for the sake of checking
# cref targets; suppressing CS1591 and CS1573 there keeps documentation optional, so the
# rule below costs nothing it should not.
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.CS8618.severity = error      # non-nullable not initialised
dotnet_diagnostic.CS8602.severity = error      # dereference of possibly null
dotnet_diagnostic.CA2007.severity = none       # ConfigureAwait: not needed in ASP.NET Core
dotnet_diagnostic.CA1848.severity = none       # LoggerMessage delegates: overkill for a template
dotnet_diagnostic.CA1515.severity = none       # 'make internal': types are the template's public surface

#### Naming ####

dotnet_naming_rule.interfaces_start_with_i.severity = error
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbol
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i_pascal
dotnet_naming_symbols.interface_symbol.applicable_kinds = interface
dotnet_naming_style.prefix_i_pascal.required_prefix = I
dotnet_naming_style.prefix_i_pascal.capitalization = pascal_case

dotnet_naming_rule.types_are_pascal_case.severity = error
dotnet_naming_rule.types_are_pascal_case.symbols = type_symbol
dotnet_naming_rule.types_are_pascal_case.style = pascal
dotnet_naming_symbols.type_symbol.applicable_kinds = class, struct, enum, delegate
dotnet_naming_style.pascal.capitalization = pascal_case

dotnet_naming_rule.type_parameters_prefix_t.severity = error
dotnet_naming_rule.type_parameters_prefix_t.symbols = type_parameter_symbol
dotnet_naming_rule.type_parameters_prefix_t.style = prefix_t_pascal
dotnet_naming_symbols.type_parameter_symbol.applicable_kinds = type_parameter
dotnet_naming_style.prefix_t_pascal.required_prefix = T
dotnet_naming_style.prefix_t_pascal.capitalization = pascal_case

dotnet_naming_rule.private_fields_are_camel_underscore.severity = warning
dotnet_naming_rule.private_fields_are_camel_underscore.symbols = private_field_symbol
dotnet_naming_rule.private_fields_are_camel_underscore.style = underscore_camel
dotnet_naming_symbols.private_field_symbol.applicable_kinds = field
dotnet_naming_symbols.private_field_symbol.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

#### Generated code ####

#### Targeted, justified suppressions ####
# Each entry below is scoped to a single file and states why the rule does not apply.
# Never add a repo-wide NoWarn instead of an entry here.

[Src/Application/AppTemplate.Application.Core/Common/Results/Error.cs]
# CA1716 warns that the type name `Error` collides with a VB.NET reserved keyword, so that
# VB consumers would need bracket-escaping. This template is a C#-only ASP.NET Core API
# with no cross-language consumers, and `Error` is the established name for this concept in
# the Result pattern — it is already consumed by every vertical. Renaming would cost
# clarity to satisfy a constraint that does not exist here.
dotnet_diagnostic.CA1716.severity = none

[Src/Application/AppTemplate.Application.Core/Common/Results/Result.cs]
# CA1000 discourages public static members on a generic type because callers must name the
# type argument (`Result<Foo>.Success(x)`). The type-inferring entry points already exist on
# the non-generic `Result` (`Result.Success<T>` / `Result.Failure<T>`), plus an implicit
# conversion from a value; the statics on `Result<T>` are the standard implementation of the
# pattern. Removing them would break the contract both infrastructure modules build against.
dotnet_diagnostic.CA1000.severity = none
# S4136 asks that the `Success` and `Failure` overloads each be adjacent. They are ordered as two
# pairs instead -- non-generic, then generic -- because each member's own documentation names the
# other half of its pair as its counterpart. Grouping by name would break both readings.
dotnet_diagnostic.S4136.severity = none

[Src/Domain/AppTemplate.Domain.Core/Common/Exceptions/DomainException.cs]
# CA1032 asks every exception type to offer the three standard constructors, including a
# parameterless one. This exception reports a violated domain invariant, and the message is
# the only thing that tells a caller which invariant it was; an instance carrying no message
# would be unactionable at the catch site and useless in a log. The two message-bearing
# constructors are deliberately the whole surface.
dotnet_diagnostic.CA1032.severity = none

[Src/Application/AppTemplate.Application.Auth/Features/Auth/UseCases/Commands/SignInWithExternalProvider/SignInWithExternalProviderUseCase.cs]
# S107 counts eight constructor parameters. They are eight distinct collaborators -- a token
# verifier, the external-login store, accounts, access tokens, refresh grants, the two-factor
# challenge, the security log and the validator -- and this use case needs each exactly once. A
# parameter object would group them by nothing, and the one grouping that is real (the token pair)
# cannot live here: `AppTemplate.Application.Auth` registers no service, which
# `LayoutConventionTests` enforces and states the reason for.
dotnet_diagnostic.S107.severity = none

[Src/Application/AppTemplate.Application/Features/Reminders/UseCases/Commands/FireDueReminders/FireDueRemindersUseCase.cs]
# S107 counts eight constructor parameters: the repository, the target queries, the notifier, the
# diagnostics, the unit of work, the clock, the leader lease and the logger. Each is used on a
# different line of one pass, and no two of them share a subject -- any parameter object here would
# be a bag named after its own arity.
dotnet_diagnostic.S107.severity = none

[Src/Domain/AppTemplate.Domain.Core/Common/Primitives/Entity.cs]
# S4035 asks that a class implementing IEquatable<T> be sealed, because a derived type inheriting
# the comparison can break symmetry. `Equals` compares `GetType() == other.GetType()` before the
# ids, which is exactly the guard the rule is protecting -- and this is the abstract base every
# aggregate derives from, so sealing it is not available.
dotnet_diagnostic.S4035.severity = none

[Src/Domain/AppTemplate.Domain/Features/Files/ValueObjects/Sha256Checksum.cs]
# S3267 suggests `Where`. The loop it names throws on the first character that is not a lowercase
# hexadecimal digit; `Where` collects rather than refuses, and this value object stays off
# `IEnumerable<char>` deliberately -- the file beside it uses `AsSpan().ContainsAny`.
dotnet_diagnostic.S3267.severity = none

[Src/Domain/AppTemplate.Domain/Features/Files/ValueObjects/StoredFileName.cs]
# S3267 suggests `Where` for a loop that throws on the first control character. A query would
# collect them; nothing here wants the set, only the refusal.
dotnet_diagnostic.S3267.severity = none

[Src/Infrastructure/AppTemplate.Infrastructure.Auth/Features/Auth/Providers/EmailChangeTokenProvider.cs]
# S6672 asks that an injected `ILogger<T>` name its enclosing type. The base class
# `DataProtectorTokenProvider<AppUser>` declares its constructor parameter as
# `ILogger<DataProtectorTokenProvider<AppUser>>` and accepts no other type, so the rule asks for a
# signature ASP.NET Core Identity does not offer.
dotnet_diagnostic.S6672.severity = none

[Src/Infrastructure/AppTemplate.Infrastructure.Auth/Features/Auth/Providers/PasswordResetTokenProvider.cs]
# S6672, and the same constraint as the provider beside it: the logger's type argument is fixed by
# `DataProtectorTokenProvider<AppUser>`'s constructor, not chosen here.
dotnet_diagnostic.S6672.severity = none

[Src/Infrastructure/AppTemplate.Infrastructure.Core/Common/Contexts/DefaultConnectionString.cs]
# S2068 sees the word `password` in a string literal. The literal is the local compose database's
# design-time fallback, documented as such three lines above it: it picks a provider when a
# migration is scaffolded and never reaches a server. A visible local default is the point --
# hiding it would suggest it is a secret.
dotnet_diagnostic.S2068.severity = none

[Src/Infrastructure/AppTemplate.Infrastructure.Core/Common/Saving/IContextUnitOfWork.cs]
# S2326 reports `TContext` as unused. Being unused is what it is for: it makes one closed generic
# per context so a container can register a commit boundary per context, which the `<remarks>` on
# the interface explains at length. A marker type parameter is the mechanism, not an oversight.
dotnet_diagnostic.S2326.severity = none

[Src/Infrastructure/AppTemplate.Infrastructure.Core/Common/Saving/Tracking/AggregateTracker.cs]
# S3267 suggests `Select(tracked => tracked.Aggregate)`. The loop it names drains each aggregate's
# events and then clears them, so a projection would do neither of the two things the loop is for.
dotnet_diagnostic.S3267.severity = none

[Src/Infrastructure/AppTemplate.Infrastructure.Persistence/Features/Files/Mapping/StoredFileMapper.cs]
# S3267 suggests `Where`. Each iteration of the reconciliation removes a tag from a dictionary and
# adds a row -- two side effects, which is what makes it a reconciliation rather than a filter.
dotnet_diagnostic.S3267.severity = none

[Src/Infrastructure/AppTemplate.Infrastructure.Persistence/Features/TodoLists/Mapping/TodoListMapper.cs]
# S3267 suggests `Where` for the same two-sided reconciliation the file-store mapper runs: remove
# from the dictionary, add a row, and record that the structure changed.
dotnet_diagnostic.S3267.severity = none

[Src/Presentation/AppTemplate.Api/Common/Hosting/DevelopmentDatabaseExtensions.cs]
# S2139 refuses logging an exception and rethrowing it. Both are wanted here and the comment at the
# catch says why: a development host that cannot reach its database says so critically, once, at the
# boundary that knows it is the database bootstrap, and then fails to start rather than serving.
dotnet_diagnostic.S2139.severity = none

[Src/Presentation/AppTemplate.Api.Core/ApiCoreModule.cs]
# AV0011 reports that the default API version is stated explicitly as 1.0. In a template, reading
# the version off a library's default is the less legible of the two -- the call site is where a
# derived project looks for it.
dotnet_diagnostic.AV0011.severity = none

[Src/Presentation/AppTemplate.Api.Core/Common/Controllers/ApiControllerBase.cs]
# S4136 asks that the `OkOrProblem` overloads be adjacent. The private helper between them carries
# the `DeclaredType` argument that makes the first one correct, and sits under its only caller;
# moving it away to group the overloads would separate the explanation from what it explains.
dotnet_diagnostic.S4136.severity = none

[Src/Presentation/AppTemplate.Api.Core/Common/Errors/ProblemTypes.cs]
# S1075 reports a hard-coded URI. It is the default base for a `ProblemDetails` `type` member, on
# the reserved `.example` TLD, and `ProblemTypeOptions.BaseUri` replaces it in any deployment that
# publishes its own problem documents.
dotnet_diagnostic.S1075.severity = none
[**/Migrations/*.cs]
generated_code = true
dotnet_diagnostic.IDE0005.severity = none

[Tests/**/*.cs]
# Test classes are instantiated by the runner; unused-parameter analysis is noisy there.
dotnet_diagnostic.CA1707.severity = none   # underscores in test method names are intentional
