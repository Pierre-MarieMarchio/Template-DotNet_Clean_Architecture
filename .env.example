# Template for the local `.env` that docker-compose.yml reads.
#
#     cp .env.example .env      # then edit if you need to
#
# `.env` is git-ignored; this file is tracked and MUST NOT contain a real secret.
# Every variable has a working localhost default, so `cp .env.example .env &&
# docker compose up --build` succeeds unmodified. Change all of them before
# pointing this stack at anything shared.
#
# The API validates its configuration at STARTUP (IValidateOptions +
# ValidateOnStart), so a bad value here fails the container fast and loudly
# instead of surfacing on the first request. Ranges noted below are enforced.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=appuser_local_dev

# Host port for the database, bound to 127.0.0.1 only. Needed solely so a psql or
# GUI client on the host can connect; the API uses the compose network instead.
POSTGRES_HOST_PORT=5432

# --- API --------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
API_HOST_PORT=8080

# --- Mailpit host ports (loopback only) -------------------------------------
# The web UI is where confirmation emails land. The SMTP port is published so the
# "run on the host" path (dotnet run against `docker compose up -d db mailpit`)
# can deliver mail too; the API inside the stack uses the compose network.
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# --- Jwt section ------------------------------------------------------------
# Signing key for HS256. Minimum 32 bytes, enforced at startup. Generate one:
#   openssl rand -base64 48
# Read by the api service alone. The worker service composes the identity module too, so it needs
# the Jwt section to validate, but it signs and verifies nothing — docker-compose.yml hands it a
# fixed placeholder rather than this value. See SECURITY.md.
JWT_KEY=dev-only-signing-key-not-for-production-replace-me-0123456789ab
JWT_ISSUER=AppTemplate.Api.Development
JWT_AUDIENCE=AppTemplate.Client.Development
# false is correct only for local development or behind a TLS-terminating proxy.
JWT_REQUIRE_HTTPS_METADATA=false
# 1..1440
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60

# --- Storage section (object store for the Files feature) ---------------------
# MinIO stands in for S3 locally. The bucket is created by the `minio-bucket` one-shot service
# in docker-compose.yml, which also forbids anonymous reads — a publicly readable bucket would
# make every signed URL in this template decoration. In production, leave the two credentials
# EMPTY and let the SDK resolve an instance role instead; a long-lived key pair in an
# environment variable is exactly what that avoids. See SECURITY.md.
STORAGE_BUCKET_NAME=app-files
STORAGE_ENDPOINT=http://minio:9000
# The name YOUR BROWSER resolves, which is not the name the API uses. MinIO is `minio:9000` on the
# Docker network and `localhost:9000` on this machine, and a presigned URL covers the host it was
# signed for — so signing for the first would mint URLs nothing on this machine can follow.
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_FORCE_PATH_STYLE=true
STORAGE_ALLOW_INSECURE_TRANSPORT=true
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- RefreshToken section ---------------------------------------------------
# 1..90
REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Identity section (password, lockout, sign-in policy) -------------------
# PasswordRequiredLength has a hard floor of 8; anything lower is rejected.
IDENTITY_PASSWORD_LENGTH=8
IDENTITY_PASSWORD_UNIQUE_CHARS=1
IDENTITY_PASSWORD_REQUIRE_DIGIT=false
IDENTITY_PASSWORD_REQUIRE_LOWERCASE=false
IDENTITY_PASSWORD_REQUIRE_UPPERCASE=false
IDENTITY_PASSWORD_REQUIRE_NONALPHANUMERIC=false
IDENTITY_LOCKOUT_ENABLED=true
# 1..20
IDENTITY_LOCKOUT_MAX_ATTEMPTS=10
# >= 1
IDENTITY_LOCKOUT_DURATION_MINUTES=1
IDENTITY_REQUIRE_CONFIRMED_EMAIL=true
# Cannot be disabled: the user table has a unique index on the normalised email.
IDENTITY_REQUIRE_UNIQUE_EMAIL=true

# --- Email section (SMTP) ---------------------------------------------------
# Defaults target the `mailpit` service in docker-compose.yml. Its web UI is on
# http://localhost:8025 — that is where confirmation emails land.
#
# EMAIL_SECURITY is a MailKit SecureSocketOptions name: None, Auto, SslOnConnect,
# StartTls or StartTlsWhenAvailable. Startup validation rejects EVERY mode that
# can end up sending in the clear — None, StartTlsWhenAvailable AND Auto — for a
# host that is not loopback, unless EMAIL_ALLOW_INSECURE_TRANSPORT is true.
# `Auto` is in that list on purpose: MailKit resolves it to StartTlsWhenAvailable
# on any port other than 465, so allowing it would reopen the same silent
# downgrade under a friendlier name.
#
# mailpit speaks no TLS at all and `mailpit` is not a loopback host, so the
# development stack states the insecure transport outright: None plus an explicit
# opt-in. That is auditable; picking a permissive Security mode is not. For any
# real relay use StartTls or SslOnConnect and leave the opt-in false.
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_SECURITY=None
EMAIL_ALLOW_INSECURE_TRANSPORT=true
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=no-reply@localhost
EMAIL_FROM_NAME=AppTemplate (dev)

# --- Localization -----------------------------------------------------------
# The language a mail is written in when the reader has not said which one they
# read — the API takes it from Accept-Language when a request says so, and the
# worker always uses this. Startup fails on a culture the runtime does not know.
#
# There is NO list of supported languages here on purpose: what a mail can be
# written in is which templates ship. Adding one is adding
# <Mail>EmailTemplate.<culture>.html beside the ones in
#   Src/Infrastructure/AppTemplate.Infrastructure.Identity/Features/Auth/Templates/
#   Src/Infrastructure/AppTemplate.Infrastructure.Email/Features/Reminders/
# and nothing else. `en` and `fr` ship.
LOCALIZATION_DEFAULT_CULTURE=en

# --- EmailConfirmation section ----------------------------------------------
# Absolute http/https URL of the page that completes confirmation, with NO
# fragment — the API appends the email and token as one. Must be a URL a browser
# can reach, not an in-network container name.
CONFIRM_EMAIL_URL=http://localhost:8080/confirm-email

# --- PasswordReset section --------------------------------------------------
# Same rules as CONFIRM_EMAIL_URL: absolute http/https, no fragment. Required by
# start-up validation on BOTH hosts, because each composes the Identity module.
RESET_PASSWORD_URL=http://localhost:8080/reset-password

# --- EmailChange section -----------------------------------------------------
# Same rules again: absolute http/https, no fragment. Required by start-up
# validation on BOTH hosts, for the same reason as RESET_PASSWORD_URL.
CONFIRM_EMAIL_CHANGE_URL=http://localhost:8080/confirm-email-change

# --- Database section -------------------------------------------------------
# MAX_POOL_SIZE is per process, so the ceiling is replicas x pool size + the
# worker's own, and it must stay under the server's max_connections. See
# docs/CONFIGURATION.md — one idempotent write can hold three connections.
DATABASE_MAX_POOL_SIZE=20
DATABASE_COMMAND_TIMEOUT_SECONDS=30

# --- Idempotency purge ------------------------------------------------------
# Rows are deleted in batches so a large purge cannot hold one long lock.
IDEMPOTENCY_PURGE_BATCH_SIZE=1000

# --- Maintenance worker -----------------------------------------------------
# The background host that runs the purges. Each task can be turned off on its
# own; the interval applies to both.
MAINTENANCE_WORKER_INTERVAL=01:00:00
MAINTENANCE_WORKER_PURGE_IDEMPOTENCY_KEYS=true
MAINTENANCE_WORKER_PURGE_REFRESH_TOKENS=true

# --- Reminder worker --------------------------------------------------------
# The loop that rings a reminder that has come due. Enabled=false stops that loop
# and leaves the rest of the worker running — the off switch for a stack that
# wants the purges without any reminder mail leaving the box.
REMINDER_WORKER_INTERVAL=00:01:00
REMINDER_WORKER_ENABLED=true

# --- File worker ------------------------------------------------------------
# Three passes, timed separately because they cost differently by orders of
# magnitude. Ranges are enforced at startup; see docs/CONFIGURATION.md.
#
# INSPECT is the one a user waits on: it is the only thing that moves a file from
# `deposited` to `available`, so until it runs an upload exists and cannot be
# opened. Shorten it while working on the Files feature. Setting ENABLED=false
# does not degrade the feature, it stops it — no upload ever becomes readable.
# Range 10 s to 1 h.
FILE_WORKER_INSPECT_INTERVAL=00:01:00
FILE_WORKER_INSPECT_ENABLED=true
#
# PURGE retires a registration nobody ever deposited against.
FILE_WORKER_PURGE_INTERVAL=01:00:00
FILE_WORKER_PURGE_ENABLED=true
#
# RECLAIM is the correctness guarantee of the whole feature: there is no soft
# delete, so the bytes of a deleted file are only ever freed because this pass
# re-derives "an object no row references is garbage". Off leaks storage silently.
FILE_WORKER_RECLAIM_INTERVAL=12:00:00
FILE_WORKER_RECLAIM_ENABLED=true

# --- IdentitySeed section — DEVELOPMENT ONLY --------------------------------
# Creates an administrator account on startup. Off by default and there is NO
# default password: if you set SEED_ENABLED=true you MUST also set
# SEED_ADMIN_PASSWORD, or startup validation fails. Never enable this anywhere
# reachable from the internet.
SEED_ENABLED=false
SEED_ADMIN_USERNAME=administrator
SEED_ADMIN_EMAIL=administrator@localhost
SEED_ADMIN_PASSWORD=

# --- Cors -------------------------------------------------------------------
CORS_ALLOWED_ORIGIN_0=http://localhost:4200
