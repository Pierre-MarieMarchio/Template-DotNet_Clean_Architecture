<Project Sdk="Microsoft.NET.Sdk">

  <!-- One SMTP client, one adapter. There is deliberately no AppTemplate.Infrastructure.Email.Core /
       AppTemplate.Infrastructure.Email.MailKit pair: the port already lives in AppTemplate.Application, so a
       second abstraction here would have exactly one implementation on each side of it. -->
  <ItemGroup>
    <PackageReference Include="MailKit" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- Brings Microsoft.Extensions.Options, its configuration binding, and ValidateOnStart. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Application\AppTemplate.Application\AppTemplate.Application.csproj" />
  </ItemGroup>

  <!-- The options validator decides whether this process is allowed to send mail over a transport
       that can fall back to plaintext. It is internal, like everything here except the options type
       and the module, and its rule is a single expression over an enum — so its tests have to name
       it directly rather than infer its verdict from a start-up exception message. Shared with
       exactly one assembly. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>AppTemplate.Infrastructure.Email.UnitTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
