<Window x:Class="AppTemplate.PresentationAppDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AppTemplate.PresentationAppDesktop"
        Width="480" Height="360">

    <StackPanel Margin="24">
        <TextBlock Text="{Binding ApiAddress, StringFormat='API: {0}'}" Margin="0,0,0,12" />
<!--#if (localAuth)-->
        <StackPanel Style="{StaticResource WhenSignedOut}">
            <Label Content="_Email" Target="{Binding ElementName=EmailInput}" Padding="0,0,0,4" />
            <TextBox x:Name="EmailInput" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
            <Label Content="_Password" Target="{Binding ElementName=PasswordInput}" Padding="0,8,0,4" />
            <PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged" />
            <Button Content="Sign in" Command="{Binding SignInCommand}" IsDefault="True" HorizontalAlignment="Left" Padding="12,4" Margin="0,12,0,0" />
        </StackPanel>
<!--#else-->
        <StackPanel Style="{StaticResource WhenSignedOut}">
            <Button Content="Sign in" Command="{Binding SignInCommand}" HorizontalAlignment="Left" Padding="12,4" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
<!--#endif-->
        <StackPanel Style="{StaticResource WhenSignedIn}">
            <TextBlock Text="{Binding SignedInAs, StringFormat='Signed in as {0}'}" />
            <Button Content="Sign out" Command="{Binding SignOutCommand}" HorizontalAlignment="Left" Padding="12,4" Margin="0,8,0,0" />
        </StackPanel>
        <TextBlock Text="{Binding Problem}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,12,0,0" />
    </StackPanel>

</Window>
