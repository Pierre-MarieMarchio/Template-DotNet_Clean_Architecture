<Project Sdk="Microsoft.NET.Sdk">

  <!-- The agnostic half of the infrastructure layer: mechanisms a module needs and no module owns.
       An infrastructure module may not reference a sibling, so without this project two modules
       needing one mechanism have nowhere to share it and each keeps a copy.

       One of the vendored SDK projects: a derived repository copies it and is free to tune it.
       The marker below is what the architecture rules read to hold it to the SDK boundary. -->
  <PropertyGroup>
    <IsSdkProject>true</IsSdkProject>
  </PropertyGroup>

  <!-- CS1591 is suppressed repository-wide, and re-enabled here: this is a deliberate public
       surface that a derived project reads instead of reading the code, so every public member
       owes it a sentence. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn.Replace('CS1591', ''))</NoWarn>
  </PropertyGroup>

  <!-- HybridCache rather than IDistributedCache: it is an in-process cache until a deployment
       registers a distributed one, so the template runs on `dotnet run` with nothing to deploy, and
       the second level is added without any caller changing. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
  </ItemGroup>

  <!-- EF Core, for the saving mechanisms a module composes over its own context: the unit of work,
       the three interceptors and the aggregate tracker. The provider is not here — which database
       a context talks to is the module's decision, not this project's. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <!-- Read by DefaultConnectionString, which is the one name every context in the system reaches
         its database through. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Application\AppTemplate.Application.Core\AppTemplate.Application.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>AppTemplate.Infrastructure.Core.UnitTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
