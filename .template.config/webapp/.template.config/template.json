{
  "$schema": "http://json.schemastore.org/template",
  "author": "Pierre-MarieMarchio",
  "classifications": [
    "Web",
    "Clean Architecture"
  ],
  "identity": "CleanArch.WebApi.WebApp.TypeScript",
  "groupIdentity": "CleanArch.WebApi.WebApp",
  "name": ".NET Clean Architecture Web App",
  "shortName": "cleanarch-webapp",
  "description": "One more web app in the pnpm workspace Src/Web of a project generated by cleanarch-webapi, or its first with --workspace: its own folder, nginx image and Compose service, relaying /api to the API. Run it at the project root.",
  "preferNameDirectory": false,
  "tags": {
    "language": "TypeScript",
    "type": "item"
  },
  "symbols": {
    "framework": {
      "type": "parameter",
      "displayName": "Framework",
      "datatype": "choice",
      "isRequired": true,
      "choices": [
        { "choice": "placeholder", "description": "A static page served by nginx, relaying /api to the API." },
        { "choice": "react", "description": "The same app as vite-react, kept under this name until the next major version." },
        { "choice": "angular", "description": "An Angular app, created by the Angular CLI (ng new) when web-scaffold runs." },
        { "choice": "vue", "description": "A Vue app, created by Vue's official CLI (create-vue, with TypeScript, Vue Router, Vitest and ESLint) when web-scaffold runs." },
        { "choice": "vite-react", "description": "A React app, created by Vite's official CLI (create-vite, react-ts) when web-scaffold runs." },
        { "choice": "vite-vue", "description": "A Vue app, created by Vite's official CLI (create-vite, vue-ts) when web-scaffold runs." },
        { "choice": "vite-svelte", "description": "A Svelte app, created by Vite's official CLI (create-vite, svelte-ts) when web-scaffold runs." },
        { "choice": "react-router", "description": "A React app, created by React Router's official CLI (create-react-router) in single-page mode when web-scaffold runs." },
        { "choice": "blazor-wasm", "description": "A Blazor WebAssembly app calling the API through the .NET client; generate the project with --web blazor-wasm, which this item template does not add yet." }
      ],
      "description": "The app's framework."
    },
    "audience": {
      "type": "parameter",
      "displayName": "Audience",
      "datatype": "choice",
      "defaultValue": "public",
      "choices": [
        { "choice": "public", "description": "A site for the API's users." },
        { "choice": "admin", "description": "A back office for administrators; needs an API that authenticates." }
      ],
      "description": "Who the app is for; the framework apps shape their screens by it."
    },
    "workspace": {
      "type": "parameter",
      "displayName": "Create the workspace",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Also create the pnpm workspace Src/Web around the app - its root, the shared packages and the api-client - and the web workflow: for the first app of a project generated with --web none. Refused where Src/Web exists, since it would overwrite the workspace's files."
    },
    "scope": {
      "type": "parameter",
      "displayName": "Package scope",
      "datatype": "text",
      "defaultValue": "",
      "isRequired": "(framework != \"placeholder\" || workspace)",
      "description": "The workspace's package scope without the @, as in Src/Web/package.json (for example acme-shop): a framework app depends on @<scope>/api-client. With --workspace, the project's name in lower case, dots turned to dashes, as --web names it.",
      "replaces": "app-template"
    },
    "port": {
      "type": "parameter",
      "displayName": "Host port",
      "datatype": "integer",
      "description": "The app's default host port on 127.0.0.1, overridden by WEB_<NAME>_HOST_PORT in .env. Defaults to 8082, or with --workspace to the port --web gives the framework: 8081, 5173 or 4200."
    },
    "defaultPort": {
      "type": "generated",
      "generator": "switch",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          { "condition": "(workspace && webVite)", "value": "5173" },
          { "condition": "(workspace && webAngular)", "value": "4200" },
          { "condition": "(workspace)", "value": "8081" },
          { "condition": "(true)", "value": "8082" }
        ]
      }
    },
    "appPort": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "port",
        "fallbackVariableName": "defaultPort"
      },
      "replaces": "8081"
    },
    "ci": {
      "type": "parameter",
      "displayName": "Project generated with --ci",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "The project's --ci value: with --workspace, the web workflow joins the others."
    },
    "agentFiles": {
      "type": "parameter",
      "displayName": "Project generated with --agent-files",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "The project's --agent-files value: with --workspace, Src/Web/AGENTS.md joins the root AGENTS.md."
    },
    "auth": {
      "type": "parameter",
      "displayName": "Project authentication",
      "datatype": "choice",
      "defaultValue": "local",
      "choices": [
        { "choice": "local", "description": "The project was generated with --auth local." },
        { "choice": "external", "description": "The project was generated with --auth external." },
        { "choice": "none", "description": "The project was generated with --auth none." }
      ],
      "description": "The project's --auth value: the app's sign-in screens follow it."
    },
    "adminNeedsAccounts": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        { "choice": "refused", "description": "Not an option to set: it names the refusal." }
      ],
      "isRequired": "(audience == \"admin\" && auth == \"none\")",
      "description": "Never set. --audience admin signs administrators in, which --auth none cannot."
    },
    "wasmWebAppNotYetGenerated": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        { "choice": "refused", "description": "Not an option to set: it names the refusal." }
      ],
      "isRequired": "(framework == \"blazor-wasm\")",
      "description": "Never set. This version of cleanarch-webapp does not add a Blazor WebAssembly app, which brings the .NET client: generate the project with --web blazor-wasm."
    },
    "localAuth": { "type": "computed", "value": "(auth == \"local\")" },
    "externalAuth": { "type": "computed", "value": "(auth == \"external\")" },
    "publicApi": { "type": "computed", "value": "(auth == \"none\")" },
    "accounts": { "type": "computed", "value": "(localAuth || externalAuth)" },
    "browserSessions": { "type": "computed", "value": "(localAuth)" },
    "anyWeb": { "type": "computed", "value": "true" },
    "webPlaceholder": { "type": "computed", "value": "(framework == \"placeholder\")" },
    "webAngular": { "type": "computed", "value": "(framework == \"angular\")" },
    "webVue": { "type": "computed", "value": "(framework == \"vue\")" },
    "webViteReact": { "type": "computed", "value": "(framework == \"vite-react\" || framework == \"react\")" },
    "webViteVue": { "type": "computed", "value": "(framework == \"vite-vue\")" },
    "webViteSvelte": { "type": "computed", "value": "(framework == \"vite-svelte\")" },
    "webReactRouter": { "type": "computed", "value": "(framework == \"react-router\")" },
    "webVite": { "type": "computed", "value": "(webVue || webViteReact || webViteVue || webViteSvelte || webReactRouter)" },
    "webBlazorWasm": { "type": "computed", "value": "(framework == \"blazor-wasm\")" },
    "webNodeFramework": { "type": "computed", "value": "(webAngular || webVite)" },
    "webFramework": { "type": "computed", "value": "(webNodeFramework || webBlazorWasm)" },
    "adminAudience": { "type": "computed", "value": "(audience == \"admin\")" },
    "appName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "identity",
      "replaces": "PlaceholderSite",
      "fileRename": "PlaceholderSite"
    },
    "appNameFramework": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "identity",
      "replaces": "FrameworkSite",
      "fileRename": "FrameworkSite"
    },
    "appNameWords": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "name",
        "steps": [
          { "regex": "([A-Z]+)([A-Z][a-z])", "replacement": "$1-$2" },
          { "regex": "([a-z0-9])([A-Z])", "replacement": "$1-$2" },
          { "regex": "[.\\s_-]+", "replacement": "-" }
        ]
      }
    },
    "appNameKebab": {
      "type": "generated",
      "generator": "casing",
      "parameters": { "source": "appNameWords", "toLower": true },
      "replaces": "placeholder-site"
    },
    "appNameUpper": {
      "type": "generated",
      "generator": "casing",
      "parameters": { "source": "appNameWords", "toLower": false }
    },
    "appNameEnvironment": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "appNameUpper",
        "steps": [{ "regex": "-", "replacement": "_" }]
      },
      "replaces": "PLACEHOLDER_SITE"
    },
    "appNameKebabFramework": {
      "type": "generated",
      "generator": "casing",
      "parameters": { "source": "appNameWords", "toLower": true },
      "replaces": "framework-site"
    },
    "appNameEnvironmentFramework": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "appNameUpper",
        "steps": [{ "regex": "-", "replacement": "_" }]
      },
      "replaces": "FRAMEWORK_SITE"
    },
    "vitePort": {
      "type": "generated",
      "generator": "join",
      "parameters": {
        "symbols": [{ "type": "ref", "value": "appPort" }],
        "separator": ""
      },
      "replaces": "5173"
    },
    "angularPort": {
      "type": "generated",
      "generator": "join",
      "parameters": {
        "symbols": [{ "type": "ref", "value": "appPort" }],
        "separator": ""
      },
      "replaces": "4200"
    }
  },
  "sources": [
    {
      "source": "../../Src/Web/apps/",
      "target": "./Src/Web/apps/",
      "modifiers": [
        {
          "exclude": [
            "**/node_modules/**",
            "**/dist/**",
            "**/coverage/**"
          ]
        },
        {
          "condition": "(!webPlaceholder)",
          "exclude": [
            "PlaceholderSite/**"
          ]
        },
        {
          "condition": "(!webFramework)",
          "exclude": [
            "FrameworkSite/**"
          ]
        }
      ]
    },
    {
      "source": "../starters/angular/",
      "target": "./Src/Web/apps/",
      "condition": "(webAngular)"
    },
    {
      "source": "../starters/vue/",
      "target": "./Src/Web/apps/",
      "condition": "(webVue)"
    },
    {
      "source": "../starters/vite-react/",
      "target": "./Src/Web/apps/",
      "condition": "(webViteReact)"
    },
    {
      "source": "../starters/vite-vue/",
      "target": "./Src/Web/apps/",
      "condition": "(webViteVue)"
    },
    {
      "source": "../starters/vite-svelte/",
      "target": "./Src/Web/apps/",
      "condition": "(webViteSvelte)"
    },
    {
      "source": "../starters/react-router/",
      "target": "./Src/Web/apps/",
      "condition": "(webReactRouter)"
    },
    {
      "source": "../starters/blazor-wasm/",
      "target": "./Src/Web/apps/",
      "condition": "(webBlazorWasm)"
    },
    {
      "source": "../../Src/Web/",
      "target": "./Src/Web/",
      "condition": "(workspace)",
      "modifiers": [
        {
          "exclude": [
            "apps/**",
            "**/node_modules/**",
            "**/dist/**",
            "**/coverage/**",
            "packages/api-client/openapi/**",
            "pnpm-lock.yaml"
          ]
        },
        {
          "condition": "(!agentFiles)",
          "exclude": [
            "AGENTS.md"
          ]
        }
      ]
    },
    {
      "source": "../variants/web-PlaceholderSite/",
      "target": "./",
      "condition": "(workspace && webPlaceholder)"
    },
    {
      "source": "../../.github/workflows/",
      "target": "./.github/workflows/",
      "condition": "(workspace && ci)",
      "include": [
        "web.yml"
      ]
    },
    {
      "source": "../../docs/",
      "target": "./docs/",
      "condition": "(workspace)",
      "include": [
        "features/web-frontend.md",
        "decisions/0019-one-generated-api-client.md"
      ]
    }
  ],
  "postActions": [
    {
      "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
      "description": "Start the app with the rest of the stack.",
      "manualInstructions": [
        {
          "text": "In docker-compose.yml, add '  - path: Src/Web/apps/<name>/compose.yml' under include:, and add WEB_<NAME>_HOST_PORT to .env.example; Src/Web/apps/<name>/README.md gives both lines. A framework app is created by its official CLI: run dotnet run Tools/Tasks.cs web-scaffold <name> at the project root (or bootstrap), then commit the app with Src/Web/pnpm-lock.yaml. A placeholder needs only pnpm install in Src/Web."
        }
      ],
      "continueOnError": true
    },
    {
      "condition": "(workspace)",
      "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
      "description": "Wire the new workspace into the project.",
      "manualInstructions": [
        {
          "text": "Src/Web/README.md, under 'The first app of a project generated without one', gives the lines --web writes outside Src/Web: the include block in docker-compose.yml, the port in .env.example, Src/Web/ in .dockerignore, the two web entries of .github/dependabot.yml, and the web rows of the documentation index, the decision index and ADR 0001 (with --auth local, ADR 0016's web paragraph)."
        }
      ],
      "continueOnError": true
    }
  ]
}
