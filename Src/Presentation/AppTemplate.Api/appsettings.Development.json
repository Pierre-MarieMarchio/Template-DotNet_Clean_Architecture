{
  "ConfigurationGuide": "Development overrides. ASP.NET Core loads this file only when ASPNETCORE_ENVIRONMENT=Development and only under this exact name. Values here are localhost throwaways, tracked in git so that `dotnet run` works straight after `git clone`. Never reuse them anywhere reachable from a network. `dotnet user-secrets` overrides this file and is where anything genuinely secret belongs. Email:Host is localhost, which is a loopback address, so Email:Security=None is accepted without Email:AllowInsecureTransport — a non-loopback plaintext relay such as the `mailpit` container in docker-compose.yml needs the explicit opt-in instead.",
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=appdb;Username=appuser;Password=appuser_local_dev;Include Error Detail=true"
  },
  "Jwt": {
    "Key": "dev-only-signing-key-not-for-production-replace-me-0123456789ab",
    "Issuer": "AppTemplate.Api.Development",
    "Audience": "AppTemplate.Client.Development",
    "RequireHttpsMetadata": false,
    "AccessTokenLifetimeInMinutes": 60
  },
  "RefreshToken": {
    "LifetimeInDays": 7
  },
  "Identity": {
    "PasswordRequiredLength": 8,
    "PasswordRequiredUniqueChars": 4,
    "PasswordRequireDigit": true,
    "PasswordRequireLowercase": true,
    "PasswordRequireUppercase": true,
    "PasswordRequireNonAlphanumeric": true,
    "LockoutEnabled": true,
    "LockoutMaxFailedAccessAttempts": 10,
    "LockoutDurationInMinutes": 5,
    "RequireConfirmedEmail": true,
    "RequireUniqueEmail": true
  },
  "Email": {
    "Host": "localhost",
    "Port": 1025,
    "Security": "None",
    "AllowInsecureTransport": false,
    "UserName": "",
    "Password": "",
    "FromAddress": "no-reply@localhost",
    "FromName": "AppTemplate (dev)"
  },
  "EmailConfirmation": {
    "ConfirmEmailUrl": "http://localhost:5187/confirm-email",
    "Subject": "Confirm your email address"
  },
  "PasswordResetOutcome": {
    "ResetPasswordUrl": "http://localhost:5187/reset-password"
  },
  "EmailChange": {
    "ConfirmEmailChangeUrl": "http://localhost:5187/confirm-email-change"
  },
  "IdentitySeed": {
    "Enabled": false,
    "AdminUserName": "administrator",
    "AdminEmail": "administrator@localhost",
    "AdminPassword": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:5173"
    ]
  }
}
