  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            ".template.config/**",
            ".git",
            ".git/**",
            "**/bin/**",
            "**/obj/**",
            "artifacts/**",
            "TestResults/**",
            ".env",
            ".vs/**",
            "README.md",
            "LICENSE",
            "docs/template/**",
            "docs/plans/**",
            "Tests/Integration/AppTemplate.Api.IntegrationTests/OpenApi/v1.json",
            "docs/guide_architecture_pour_agent.md",
            "CHANGELOG.md",
            ".github/workflows/template-acceptance.yml",
            ".github/workflows/template-release.yml",
            ".github/ISSUE_TEMPLATE/**",
            "Tools/CheckDocPaths.cs",
            "Tools/CheckWorkflows.cs",
            "Tools/CheckComments.cs",
            "Launcher/**",
            "Src/Web/**/node_modules/**",
            "Src/Web/**/dist/**",
            "Src/Web/**/coverage/**",
            "Src/Web/packages/api-client/openapi/**",
            "Src/Web/pnpm-lock.yaml",
            "Src/Infrastructure/AppTemplate.Infrastructure.Persistence/Migrations/**",
            "Src/Infrastructure/AppTemplate.Infrastructure.Auth/Migrations/**"
          ]
        },
        {
          "condition": "(!postgreSql)",
          "exclude": [
            "Src/Infrastructure/AppTemplate.Infrastructure.Core/Common/Contexts/DatabaseProvider.cs",
            "Src/Infrastructure/AppTemplate.Infrastructure.Persistence/Common/Leases/LeaderLease.cs",
            "Src/Infrastructure/AppTemplate.Infrastructure.Persistence/Features/Files/Adapters/Locks/OwnerQuotaLock.cs",
            "Src/Presentation/AppTemplate.Api/Common/Observability/DatabaseInstrumentation.cs",
            "docker-compose.database.yml",
            "Tests/Infrastructure/AppTemplate.Infrastructure.Core.UnitTests/Common/Contexts/DatabaseProviderTests.cs",
            "Tests/Infrastructure/AppTemplate.Infrastructure.Auth.UnitTests/Fixtures/DatabaseFaults.cs",
            "Tests/Infrastructure/AppTemplate.Infrastructure.Persistence.UnitTests/Features/Files/Adapters/Locks/OwnerQuotaLockTests.cs",
            "Tests/Infrastructure/AppTemplate.Infrastructure.Persistence.UnitTests/PersistenceModuleConnectionStringTests.cs",
            "Tests/Integration/AppTemplate.Api.IntegrationTests/Infrastructure/DatabaseServer.cs",
            "Tests/Integration/AppTemplate.Infrastructure.Auth.IntegrationTests/Fixtures/DatabaseServer.cs"
          ]
        },
        {
          "condition": "(!serverDatabase)",
          "exclude": [
            ".github/workflows/release.yml"
          ]
        },
        {
          "condition": "(!versionCounter)",
          "exclude": [
            "Src/Infrastructure/AppTemplate.Infrastructure.Core/Common/Saving/Versioning/**",
            "Tests/Infrastructure/AppTemplate.Infrastructure.Core.UnitTests/Common/Saving/Versioning/**"
          ]
        },
        {
          "condition": "(!tablePrefixes)",
          "exclude": [
            "Src/Infrastructure/AppTemplate.Infrastructure.Core/Common/Contexts/SchemaAsTablePrefixConvention.cs",
            "Tests/Infrastructure/AppTemplate.Infrastructure.Core.UnitTests/Common/Contexts/SchemaAsTablePrefixConventionTests.cs"
          ]
        },
        {
          "condition": "(!anyWeb)",
          "exclude": [
            "Src/Web/**",
            ".github/workflows/web.yml",
            "docs/features/web-frontend.md",
            "docs/decisions/0019-one-generated-api-client.md",
            "Tests/EndToEnd/AppTemplate.EndToEnd.Tests/WebAppTests.cs"
          ]
        },
        {
          "condition": "(!webPlaceholder)",
          "exclude": [
            "Src/Web/apps/PlaceholderSite/**"
          ]
        },
        {
          "condition": "(!webReact)",
          "exclude": [
            "Src/Web/apps/ReactSite/**"
          ]
        },
        {
          "condition": "(!webAngular)",
          "exclude": [
            "Src/Web/apps/AngularSite/**"
          ]
        },
        {
