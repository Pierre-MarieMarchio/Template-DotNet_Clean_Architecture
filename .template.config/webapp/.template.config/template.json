{
  "$schema": "http://json.schemastore.org/template",
  "author": "AppTemplate contributors",
  "classifications": [
    "Web",
    "Clean Architecture"
  ],
  "identity": "AppTemplate.Templates.CleanArchitectureWebApp",
  "name": ".NET Clean Architecture web app",
  "shortName": "cleanarch-webapp",
  "description": "One more web app in the pnpm workspace Src/Web of a project generated by cleanarch-webapi: its own folder, nginx image and Compose service, relaying /api to the API. Run it at the project root.",
  "preferNameDirectory": false,
  "tags": {
    "language": "TypeScript",
    "type": "item"
  },
  "symbols": {
    "framework": {
      "type": "parameter",
      "datatype": "choice",
      "isRequired": true,
      "choices": [
        { "choice": "placeholder", "description": "A static page served by nginx, relaying /api to the API." },
        { "choice": "react", "description": "A React (Vite, TypeScript) app." },
        { "choice": "angular", "description": "An Angular app." }
      ],
      "description": "The app's framework."
    },
    "audience": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "public",
      "choices": [
        { "choice": "public", "description": "A site for the API's users." },
        { "choice": "admin", "description": "A back office for administrators; needs an API that authenticates." }
      ],
      "description": "Who the app is for; the framework apps shape their screens by it."
    },
    "scope": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "isRequired": "(framework != \"placeholder\")",
      "description": "The workspace's package scope without the @, as in Src/Web/package.json (for example acme-shop): a framework app depends on @<scope>/api-client.",
      "replaces": "app-template"
    },
    "port": {
      "type": "parameter",
      "datatype": "integer",
      "defaultValue": "8082",
      "description": "The app's default host port on 127.0.0.1, overridden by WEB_<NAME>_HOST_PORT in .env.",
      "replaces": "8081"
    },
    "webPlaceholder": { "type": "computed", "value": "(framework == \"placeholder\")" },
    "webReact": { "type": "computed", "value": "(framework == \"react\")" },
    "webAngular": { "type": "computed", "value": "(framework == \"angular\")" },
    "adminAudience": { "type": "computed", "value": "(audience == \"admin\")" },
    "appName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "identity",
      "replaces": "PlaceholderSite",
      "fileRename": "PlaceholderSite"
    },
    "appNameWords": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "name",
        "steps": [
          { "regex": "([A-Z]+)([A-Z][a-z])", "replacement": "$1-$2" },
          { "regex": "([a-z0-9])([A-Z])", "replacement": "$1-$2" },
          { "regex": "[.\\s_-]+", "replacement": "-" }
        ]
      }
    },
    "appNameKebab": {
      "type": "generated",
      "generator": "casing",
      "parameters": { "source": "appNameWords", "toLower": true },
      "replaces": "placeholder-site"
    },
    "appNameUpper": {
      "type": "generated",
      "generator": "casing",
      "parameters": { "source": "appNameWords", "toLower": false }
    },
    "appNameEnvironment": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "appNameUpper",
        "steps": [{ "regex": "-", "replacement": "_" }]
      },
      "replaces": "PLACEHOLDER_SITE"
    }
  },
  "sources": [
    {
      "source": "../../Src/Web/apps/",
      "target": "./Src/Web/apps/",
      "modifiers": [
        {
          "exclude": [
            "**/node_modules/**",
            "**/dist/**",
            "**/coverage/**"
          ]
        },
        {
          "condition": "(!webPlaceholder)",
          "exclude": [
            "PlaceholderSite/**"
          ]
        }
      ]
    }
  ],
  "postActions": [
    {
      "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
      "description": "Start the app with the rest of the stack.",
      "manualInstructions": [
        {
          "text": "In docker-compose.yml, add '  - path: Src/Web/apps/<name>/compose.yml' under include:, and add WEB_<NAME>_HOST_PORT to .env.example; Src/Web/apps/<name>/README.md gives both lines. Then run pnpm install in Src/Web and commit the lockfile with the app."
        }
      ],
      "continueOnError": true
    }
  ]
}
