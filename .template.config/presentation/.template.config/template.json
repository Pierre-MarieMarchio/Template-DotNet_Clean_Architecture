{
  "$schema": "http://json.schemastore.org/template",
  "author": "Pierre-MarieMarchio",
  "classifications": [
    "Web",
    "Clean Architecture"
  ],
  "identity": "CleanArch.WebApi.Presentation.CSharp",
  "groupIdentity": "CleanArch.WebApi.Presentation",
  "name": ".NET Clean Architecture Presentation Project",
  "shortName": "cleanarch-presentation",
  "description": "A presentation project beside the API of a project generated by cleanarch-webapi without one: <project>.<name> in Src/Presentation, its tests, its image and its page, created by its framework's own template when presentation-scaffold runs, or written whole. Run it at the project root.",
  "defaultName": "Portal",
  "preferDefaultName": true,
  "preferNameDirectory": false,
  "tags": {
    "language": "C#",
    "type": "item"
  },
  "symbols": {
    "framework": {
      "type": "parameter",
      "displayName": "Framework",
      "datatype": "choice",
      "isRequired": true,
      "choices": [
        {
          "choice": "blazor-server",
          "description": "A Blazor Web App with server interactivity, created by dotnet new blazor when presentation-scaffold runs, calling the use cases in process."
        },
        {
          "choice": "avalonia",
          "description": "An Avalonia desktop app, created by dotnet new avalonia.mvvm when presentation-scaffold runs, calling the API through the .NET client of Src/Clients, which comes with it."
        },
        {
          "choice": "mcp",
          "description": "An MCP server, written whole in the shape of dotnet new mcpserver --transport remote, whose tools call the use cases in process for the caller its access key or its provider's token names. Name it with -n Mcp."
        }
      ],
      "description": "The presentation project's framework."
    },
    "projectName": {
      "type": "parameter",
      "displayName": "Project name",
      "datatype": "text",
      "isRequired": true,
      "description": "The project's name, as -n gave it to cleanarch-webapi and as its solution file is named (for example Acme.Shop): the presentation project is <project>.<name>.",
      "replaces": "AppTemplate",
      "fileRename": "AppTemplate",
      "forms": {
        "global": [
          "identity",
          "lower_safe_namespace"
        ]
      }
    },
    "presentationNameIsTaken": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        {
          "choice": "refused",
          "description": "Not an option to set: it names the refusal."
        }
      ],
      "isRequired": "(name == \"Api\" || name == \"Api.IntegrationTests\" || name == \"Api.UnitTests\" || name == \"Application\" || name == \"Application.Auth\" || name == \"Application.Auth.UnitTests\" || name == \"Application.Core\" || name == \"Application.Core.UnitTests\" || name == \"Application.UnitTests\" || name == \"Architecture.Tests\" || name == \"Client\" || name == \"Client.UnitTests\" || name == \"Domain\" || name == \"Domain.Core\" || name == \"Domain.Core.UnitTests\" || name == \"Domain.UnitTests\" || name == \"EndToEnd.Tests\" || name == \"Infrastructure.Auth\" || name == \"Infrastructure.Auth.IntegrationTests\" || name == \"Infrastructure.Auth.UnitTests\" || name == \"Infrastructure.Core\" || name == \"Infrastructure.Core.UnitTests\" || name == \"Infrastructure.Email\" || name == \"Infrastructure.Email.UnitTests\" || name == \"Infrastructure.InMemory\" || name == \"Infrastructure.InMemory.UnitTests\" || name == \"Infrastructure.Persistence\" || name == \"Infrastructure.Persistence.UnitTests\" || name == \"Infrastructure.Storage\" || name == \"Infrastructure.Storage.UnitTests\" || name == \"Presentation.Core\" || name == \"Presentation.Core.UnitTests\" || name == \"Worker\" || name == \"Worker.UnitTests\")",
      "description": "Never set. -n names a project the template already writes, which would be overwritten: choose another name, such as Portal."
    },
    "auth": {
      "type": "parameter",
      "displayName": "Project authentication",
      "datatype": "choice",
      "defaultValue": "local",
      "choices": [
        {
          "choice": "local",
          "description": "The project was generated with --auth local."
        },
        {
          "choice": "external",
          "description": "The project was generated with --auth external."
        },
        {
          "choice": "none",
          "description": "The project was generated with --auth none."
        }
      ],
      "description": "The project's --auth value: the presentation project signs people in as the API authenticates them."
    },
    "examples": {
      "type": "parameter",
      "displayName": "Project example features",
      "datatype": "choice",
      "defaultValue": "all",
      "choices": [
        {
          "choice": "all",
          "description": "The project was generated with --examples all."
        },
        {
          "choice": "notes",
          "description": "The project was generated with --examples notes."
        },
        {
          "choice": "none",
          "description": "The project was generated with --examples none."
        }
      ],
      "description": "The project's --examples value: the presentation project composes the same features."
    },
    "files": {
      "type": "parameter",
      "displayName": "Project Files module",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "The project's --files value: the presentation project composes the Files module with it."
    },
    "database": {
      "type": "parameter",
      "displayName": "Project database",
      "datatype": "choice",
      "defaultValue": "postgresql",
      "choices": [
        {
          "choice": "postgresql",
          "description": "The project was generated with --database postgresql."
        },
        {
          "choice": "sqlserver",
          "description": "The project was generated with --database sqlserver."
        },
        {
          "choice": "mysql",
          "description": "The project was generated with --database mysql."
        },
        {
          "choice": "sqlite",
          "description": "The project was generated with --database sqlite."
        }
      ],
      "description": "The project's --database value: the presentation project reads the same database."
    },
    "authNoneNeedsExamplesNone": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        {
          "choice": "refused",
          "description": "Not an option to set: it names the refusal."
        }
      ],
      "isRequired": "(auth == \"none\" && examples != \"none\")",
      "description": "Never set. A project generated with --auth none has no example feature: add --examples none."
    },
    "authNoneNeedsFilesFalse": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        {
          "choice": "refused",
          "description": "Not an option to set: it names the refusal."
        }
      ],
      "isRequired": "(auth == \"none\" && files)",
      "description": "Never set. A project generated with --auth none has no Files module: add --files false."
    },
    "clientPresentationNeedsAccounts": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        {
          "choice": "refused",
          "description": "Not an option to set: it names the refusal."
        }
      ],
      "isRequired": "(framework == \"avalonia\" && auth == \"none\")",
      "description": "Never set. --framework avalonia calls the API's versioned routes, and a project generated with --auth none publishes none."
    },
    "mcpNeedsAccounts": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        {
          "choice": "refused",
          "description": "Not an option to set: it names the refusal."
        }
      ],
      "isRequired": "(framework == \"mcp\" && auth == \"none\")",
      "description": "Never set. --framework mcp acts for the caller an access key or a provider's token names, and a project generated with --auth none names nobody."
    },
    "mySqlNotYetGenerated": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        {
          "choice": "refused",
          "description": "Not an option to set: it names the refusal."
        }
      ],
      "isRequired": "(database == \"mysql\")",
      "description": "Never set. No project is generated with --database mysql."
    },
    "localAuth": {
      "type": "computed",
      "value": "(auth == \"local\")"
    },
    "externalAuth": {
      "type": "computed",
      "value": "(auth == \"external\")"
    },
    "publicApi": {
      "type": "computed",
      "value": "(auth == \"none\")"
    },
    "accounts": {
      "type": "computed",
      "value": "(localAuth || externalAuth)"
    },
    "sqlServer": {
      "type": "computed",
      "value": "(database == \"sqlserver\")"
    },
    "mySql": {
      "type": "computed",
      "value": "(database == \"mysql\")"
    },
    "sqlite": {
      "type": "computed",
      "value": "(database == \"sqlite\")"
    },
    "todoLists": {
      "type": "computed",
      "value": "(examples == \"all\")"
    },
    "reminders": {
      "type": "computed",
      "value": "(examples == \"all\")"
    },
    "notes": {
      "type": "computed",
      "value": "(examples == \"all\" || examples == \"notes\")"
    },
    "anyFeature": {
      "type": "computed",
      "value": "(todoLists || reminders || notes || files)"
    },
    "presentationBlazorServer": {
      "type": "computed",
      "value": "(framework == \"blazor-server\")"
    },
    "presentationAvalonia": {
      "type": "computed",
      "value": "(framework == \"avalonia\")"
    },
    "presentationMcp": {
      "type": "computed",
      "value": "(framework == \"mcp\")"
    },
    "accessKeys": {
      "type": "computed",
      "value": "(localAuth && presentationMcp)",
      "description": "True when local accounts have an MCP server to call: brings the access keys its callers present, their routes, table, tests and decision."
    },
    "agentFiles": {
      "type": "parameter",
      "displayName": "Project generated with --agent-files",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "The project's --agent-files value: the lines to add name AGENTS.md only where the project has it."
    },
    "hasClient": {
      "type": "parameter",
      "displayName": "Project holds the .NET client",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "The project holds Src/Clients/<project>.Client already, generated with --web blazor-wasm or --presentation avalonia, or added by cleanarch-webapp --framework blazor-wasm: an Avalonia app uses it, and the item template writes neither the client nor its tests nor its decision."
    },
    "developmentConnectionString": {
      "type": "generated",
      "generator": "switch",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          {
            "condition": "(sqlServer)",
            "value": "Server=localhost,1433;Database=appdb;User Id=sa;Password=Local_dev_sa_1;TrustServerCertificate=True"
          },
          {
            "condition": "(mySql)",
            "value": "Server=localhost;Port=3306;Database=appdb;User=appuser;Password=appuser_local_dev"
          },
          {
            "condition": "(sqlite)",
            "value": "Data Source=App_Data/appdb.db"
          },
          {
            "condition": "(true)",
            "value": "Host=localhost;Port=5432;Database=appdb;Username=appuser;Password=appuser_local_dev;Include Error Detail=true;Gss Encryption Mode=Disable"
          }
        ]
      },
      "replaces": "Host=localhost;Port=5432;Database=appdb;Username=appuser;Password=appuser_local_dev;Include Error Detail=true;Gss Encryption Mode=Disable",
      "description": "The Default connection string of appsettings.Development.json, for the chosen database and the credentials .env.example gives it."
    },
    "projectNameLower": {
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source": "projectName",
        "toLower": true
      }
    },
    "kebabName": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "projectNameLower",
        "steps": [
          {
            "regex": "[.\\s_]+",
            "replacement": "-"
          }
        ]
      },
      "replaces": "app-template"
    },
    "presentationNameWords": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "name",
        "steps": [
          {
            "regex": "([A-Z]+)([A-Z][a-z])",
            "replacement": "$1-$2"
          },
          {
            "regex": "([a-z0-9])([A-Z])",
            "replacement": "$1-$2"
          },
          {
            "regex": "[.\\s_-]+",
            "replacement": "-"
          }
        ]
      }
    },
    "presentationNameKebab": {
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source": "presentationNameWords",
        "toLower": true
      },
      "replaces": "presentation-app"
    },
    "presentationNameUpper": {
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source": "presentationNameWords",
        "toLower": false
      }
    },
    "presentationNameEnvironment": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "presentationNameUpper",
        "steps": [
          {
            "regex": "-",
            "replacement": "_"
          }
        ]
      },
      "replaces": "PRESENTATION_APP"
    },
    "presentationProjectName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "identity",
      "replaces": "PresentationApp",
      "fileRename": "PresentationApp"
    }
  },
  "SpecialCustomOperations": {
    "**/Generated/**.cs": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [
              "//#kiota-never-if"
            ],
            "else": [
              "//#kiota-never-else"
            ],
            "elseif": [
              "//#kiota-never-elseif"
            ],
            "endif": [
              "//#kiota-never-endif"
            ],
            "trim": true,
            "wholeLine": true
          }
        }
      ]
    },
    "**/*.axaml": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [
              "<!--#if"
            ],
            "else": [
              "<!--#else-->"
            ],
            "elseif": [
              "<!--#elseif"
            ],
            "endif": [
              "<!--#endif-->"
            ],
            "trim": true,
            "wholeLine": true
          }
        }
      ]
    }
  },
  "sources": [
    {
      "source": "../starters/blazor-server/",
      "target": "./",
      "condition": "(presentationBlazorServer)",
      "modifiers": [
        {
          "condition": "(!localAuth)",
          "exclude": [
            "**/Features/Auth/**",
            "**/AccountReminderRecipientDirectory*.cs"
          ]
        },
        {
          "condition": "(!externalAuth)",
          "exclude": [
            "**/Features/ExternalIdentity/**",
            "**/ExternalIdentityReminderRecipientDirectory*.cs"
          ]
        },
        {
          "condition": "(!reminders)",
          "exclude": [
            "**/Features/Reminders/**"
          ]
        },
        {
          "condition": "(!anyFeature)",
          "exclude": [
            "**/AccountUserAccountDirectory*.cs",
            "**/ExternalIdentityUserAccountDirectory*.cs"
          ]
        },
        {
          "condition": "(localAuth)",
          "exclude": [
            "**/DataProtection*.cs"
          ]
        }
      ]
    },
    {
      "source": "../starters/avalonia/",
      "target": "./",
      "condition": "(presentationAvalonia)",
      "modifiers": [
        {
          "condition": "(!externalAuth)",
          "exclude": [
            "**/Common/Hosting/SignInOptions*.cs",
            "**/Common/Sessions/**",
            "**/TestSupport/ScriptedBrowser.cs",
            "**/TestSupport/StubProvider.cs"
          ]
        }
      ]
    },
    {
      "source": "../starters/mcp/",
      "target": "./",
      "condition": "(presentationMcp)",
      "modifiers": [
        {
          "condition": "(!localAuth)",
          "exclude": [
            "**/Features/Auth/**",
            "**/AccountReminderRecipientDirectory*.cs",
            "**/AccessKey*.cs",
            "**/TestKeys.cs"
          ]
        },
        {
          "condition": "(!externalAuth)",
          "exclude": [
            "**/Features/ExternalIdentity/**",
            "**/ExternalIdentityReminderRecipientDirectory*.cs",
            "**/McpOptions*.cs",
            "**/TestTokens.cs"
          ]
        },
        {
          "condition": "(!todoLists)",
          "exclude": [
            "**/Features/TodoLists/**"
          ]
        },
        {
          "condition": "(!reminders)",
          "exclude": [
            "**/Features/Reminders/**"
          ]
        },
        {
          "condition": "(!files)",
          "exclude": [
            "**/Features/Files/**"
          ]
        },
        {
          "condition": "(!notes)",
          "exclude": [
            "**/Features/Notes/**",
            "**/InMemoryNotes.cs"
          ]
        },
        {
          "condition": "(!anyFeature)",
          "exclude": [
            "**/AccountUserAccountDirectory*.cs",
            "**/ExternalIdentityUserAccountDirectory*.cs"
          ]
        }
      ]
    },
    {
      "source": "../../Src/",
      "target": "./Src/",
      "condition": "(accessKeys)",
      "include": [
        "Application/AppTemplate.Application.Auth/Features/AccessKeys/**",
        "Infrastructure/AppTemplate.Infrastructure.Auth/Features/AccessKeys/**",
        "Presentation/AppTemplate.Api/Features/Auth/Contracts/Mapping/AccessKeyResponseMapping.cs",
        "Presentation/AppTemplate.Api/Features/Auth/Contracts/Requests/CreateAccessKeyRequest.cs",
        "Presentation/AppTemplate.Api/Features/Auth/Contracts/Responses/AccessKeyResponse.cs",
        "Presentation/AppTemplate.Api/Features/Auth/Contracts/Responses/AccessKeysResponse.cs",
        "Presentation/AppTemplate.Api/Features/Auth/Contracts/Responses/CreatedAccessKeyResponse.cs",
        "Presentation/AppTemplate.Api/Features/Auth/Controllers/AccessKeysController.cs"
      ]
    },
    {
      "source": "../../Tests/",
      "target": "./Tests/",
      "condition": "(accessKeys)",
      "include": [
        "Application/AppTemplate.Application.Auth.UnitTests/Features/AccessKeys/**",
        "Integration/AppTemplate.Api.IntegrationTests/Auth/AccessKeyManagementTests.cs",
        "Integration/AppTemplate.Infrastructure.Auth.IntegrationTests/Features/AccessKeys/**"
      ]
    },
    {
      "source": "../../docs/",
      "target": "./docs/",
      "condition": "(accessKeys)",
      "include": [
        "decisions/0026-an-access-key-stands-for-its-owner-where-a-token-cannot-be-refreshed.md"
      ]
    },
    {
      "source": "../../Src/Clients/",
      "target": "./Src/Clients/",
      "condition": "(presentationAvalonia && !hasClient)",
      "exclude": [
        "**/bin/**",
        "**/obj/**"
      ],
      "modifiers": [
        {
          "condition": "(!localAuth)",
          "exclude": [
            "AppTemplate.Client/Common/Sessions/ApiSession.cs",
            "AppTemplate.Client/Common/Sessions/ApiSessionHandler.cs",
            "AppTemplate.Client/Common/Sessions/CookieRefreshTokenStore.cs",
            "AppTemplate.Client/Common/Sessions/IRefreshTokenStore.cs",
            "AppTemplate.Client/Common/Sessions/InMemoryRefreshTokenStore.cs",
            "AppTemplate.Client/Common/Sessions/RefreshTokenMode.cs"
          ]
        },
        {
          "condition": "(!externalAuth)",
          "exclude": [
            "AppTemplate.Client/Common/Sessions/AccessTokenHandler.cs",
            "AppTemplate.Client/Common/Sessions/IAccessTokenSource.cs"
          ]
        }
      ]
    },
    {
      "source": "../../Tests/Clients/",
      "target": "./Tests/Clients/",
      "condition": "(presentationAvalonia && !hasClient)",
      "exclude": [
        "**/bin/**",
        "**/obj/**"
      ],
      "modifiers": [
        {
          "condition": "(!localAuth)",
          "exclude": [
            "AppTemplate.Client.UnitTests/Common/Sessions/ApiSessionTests.cs"
          ]
        },
        {
          "condition": "(!externalAuth)",
          "exclude": [
            "AppTemplate.Client.UnitTests/Common/Sessions/AccessTokenHandlerTests.cs",
            "AppTemplate.Client.UnitTests/TestSupport/StubAccessTokenSource.cs"
          ]
        }
      ]
    },
    {
      "source": "../../docs/",
      "target": "./docs/",
      "include": [
        "features/presentation.md"
      ]
    },
    {
      "source": "../../docs/",
      "target": "./docs/",
      "condition": "(presentationMcp)",
      "include": [
        "decisions/0027-an-mcp-server-acts-for-the-caller-its-credential-names.md"
      ]
    },
    {
      "source": "../../docs/",
      "target": "./docs/",
      "condition": "(presentationAvalonia && !hasClient)",
      "include": [
        "decisions/0023-a-dotnet-client-generated-by-kiota.md"
      ]
    }
  ],
  "postActions": [
    {
      "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
      "description": "Join the presentation project to the project.",
      "manualInstructions": [
        {
          "text": "At the project root, run dotnet run Tools/Tasks.cs presentation-join <project>.<name>, which makes the lines --presentation writes outside the project's own folders, all or none, as Src/Presentation/<project>.<name>/README.md lists them under 'Joining a project generated without one'. Then run dotnet run Tools/Tasks.cs presentation-scaffold <project>.<name>, which creates it as its scaffold.json describes, adds it with its tests to the solution and writes the .NET client where the project calls the API through it; creating it from its framework's template needs the network, and a project written whole, the MCP server, needs none. Commit the project."
        }
      ],
      "continueOnError": true
    },
    {
      "condition": "(accessKeys)",
      "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
      "description": "Add the access keys' migration where the project has migrations.",
      "manualInstructions": [
        {
          "text": "The access keys the MCP server's callers present come with it and change the authentication context's model: in a project whose migrations exist already, run dotnet ef migrations add AddAccessKeys --project Src/Infrastructure/<project>.Infrastructure.Auth --startup-project Src/Infrastructure/<project>.Infrastructure.Auth --output-dir Migrations, and commit it."
        }
      ],
      "continueOnError": true
    }
  ]
}
