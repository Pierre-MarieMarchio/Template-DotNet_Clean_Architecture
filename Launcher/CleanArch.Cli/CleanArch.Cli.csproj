<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>CleanArch.Cli</RootNamespace>
    <TemplateConfig>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../.template.config'))/</TemplateConfig>
  </PropertyGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-cleanarch</ToolCommandName>
    <PackageId>CleanArch.Cli</PackageId>
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(TemplateConfig)template.json')), '(?&lt;="templateVersion"[^}]*"value":\s*")[^"]+'))</Version>
    <Title>.NET Clean Architecture project tool</Title>
    <Authors>Pierre-MarieMarchio</Authors>
    <Description>The tool a project generated from the CleanArch.WebApi.Templates package pins at its template version: dotnet cleanarch.</Description>
    <PackageTags>dotnet-new;dotnet-tool;clean-architecture;webapi;scaffolding</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/Pierre-MarieMarchio/cleanarch-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Pierre-MarieMarchio/cleanarch-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="CleanArch.Cli.Commands.Hosting" />
    <Using Include="CleanArch.Cli.Commands.Kernel" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CleanArch.Cli.Commands\CleanArch.Cli.Commands.csproj" />
    <ProjectReference Include="..\CleanArch.Tooling\CleanArch.Tooling.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(TemplateConfig)template.json" LogicalName=".template.config/template.json" />
    <EmbeddedResource Include="$(TemplateConfig)dotnetcli.host.json" LogicalName=".template.config/dotnetcli.host.json" />
    <EmbeddedResource Include="$(TemplateConfig)ide.host.json" LogicalName=".template.config/ide.host.json" />
    <EmbeddedResource Include="$(TemplateConfig)webapp/.template.config/template.json" LogicalName=".template.config/webapp/.template.config/template.json" />
    <EmbeddedResource Include="$(TemplateConfig)webapp/.template.config/dotnetcli.host.json" LogicalName=".template.config/webapp/.template.config/dotnetcli.host.json" />
    <EmbeddedResource Include="$(TemplateConfig)webapp/.template.config/ide.host.json" LogicalName=".template.config/webapp/.template.config/ide.host.json" />
    <EmbeddedResource Include="$(TemplateConfig)webpackage/.template.config/template.json" LogicalName=".template.config/webpackage/.template.config/template.json" />
    <EmbeddedResource Include="$(TemplateConfig)webpackage/.template.config/ide.host.json" LogicalName=".template.config/webpackage/.template.config/ide.host.json" />
    <EmbeddedResource Include="$(TemplateConfig)presentation/.template.config/template.json" LogicalName=".template.config/presentation/.template.config/template.json" />
    <EmbeddedResource Include="$(TemplateConfig)presentation/.template.config/dotnetcli.host.json" LogicalName=".template.config/presentation/.template.config/dotnetcli.host.json" />
    <EmbeddedResource Include="$(TemplateConfig)presentation/.template.config/ide.host.json" LogicalName=".template.config/presentation/.template.config/ide.host.json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="$(TemplateConfig)icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../CleanArch.Cli.Commands/**/*.cs;../CleanArch.Tooling/ProjectNames.cs" Exclude="../CleanArch.Cli.Commands/bin/**;../CleanArch.Cli.Commands/obj/**" LogicalName="source/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Generators/*/Templates/*.cs.txt" WithCulture="false" />
    <AssemblyMetadata Include="System.CommandLine" Value="@(PackageVersion->WithMetadataValue('Identity', 'System.CommandLine')->'%(Version)')" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CleanArch.Cli.Tests" />
  </ItemGroup>

  <Target Name="RequireTemplateVersion" BeforeTargets="GenerateNuspec">
    <Error Condition="'$(Version)' == ''" Text="No templateVersion symbol with a value was found in .template.config/template.json." />
  </Target>

</Project>
