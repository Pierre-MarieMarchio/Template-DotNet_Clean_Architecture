    },
    {
      "source": "./.template.config/variants/no-sonar/",
      "target": "./",
      "condition": "(!sonar)"
    },
    {
      "source": "./.template.config/variants/refused/",
      "target": "./",
      "condition": "(refusedOptions)"
    }
