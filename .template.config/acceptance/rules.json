{
  "rules": [
    {
      "paths": [
        ".template.config/acceptance/SelectLegs.cs",
        ".template.config/acceptance/CheckProjectFile.cs",
        ".template.config/acceptance/rules.json",
        ".template.config/acceptance/matrix.json",
        ".github/workflows/template-acceptance.yml"
      ],
      "tags": ["all"]
    },
    {
      "paths": [
        "launcher/CleanArch.Cli/**",
        "launcher/CleanArch.Cli.Commands/**",
        "launcher/CleanArch.Tooling/**"
      ],
      "tags": ["defaults"]
    },
    {
      "paths": [
        "docs/template/**",
        "docs/plans/**",
        "docs/guide_architecture_pour_agent.md",
        "README.md",
        "CHANGELOG.md",
        "LICENSE",
        "launcher/**",
        "tools/CheckWorkflows.cs",
        "tools/CheckComments.cs",
        "tests/Architecture/AT.Architecture.Tests/Rules/TemplatePackagingTests.cs",
        "tests/Architecture/AT.Architecture.Tests/Rules/AcceptanceSelectionTests.cs",
        "tests/Architecture/AT.Architecture.Tests/Rules/ConditionedUsingTests.cs",
        ".github/workflows/template-release.yml",
        ".github/workflows/template-published-package.yml",
        ".github/workflows/template-pull-request-title.yml",
        ".github/workflows/template-web-lockfiles.yml",
        ".github/workflows/template-web-lockfiles-commit.yml",
        ".github/release-please/**",
        ".github/ISSUE_TEMPLATE/**",
        ".github/FUNDING.yml",
        ".template.config/package/**"
      ],
      "tags": ["none"]
    },
    {
      "paths": [
        "src/AppHost/**",
        "tests/Integration/AT.AppHost.IntegrationTests/**",
        "tests/Architecture/AT.Architecture.Tests/Rules/LocalStackParityTests.cs"
      ],
      "tags": ["aspire"]
    },
    {
      "paths": [
        ".template.config/variants/project-file-web/**"
      ],
      "tags": ["web", "presentation-avalonia", "presentation-blazor-server", "presentation-mcp", "presentation-wpf"]
    },
    {
      "paths": [".template.config/variants/no-aspire/**"],
      "tags": ["all"]
    },
    {
      "paths": [".template.config/variants/database-sqlite/**"],
      "tags": ["database-sqlite"]
    },
    {
      "paths": [".template.config/variants/database-sqlserver/**"],
      "tags": ["database-sqlserver"]
    },
    {
      "paths": [".template.config/starters/blazor-server/**"],
      "tags": ["presentation-blazor-server"]
    },
    {
      "paths": [".template.config/starters/avalonia/**"],
      "tags": ["presentation-avalonia"]
    },
    {
      "paths": [".template.config/starters/mcp/**"],
      "tags": ["presentation-mcp"]
    },
    {
      "paths": [".template.config/starters/wpf/**"],
      "tags": ["presentation-wpf"]
    },
    {
      "paths": [".template.config/starters/worker/**"],
      "tags": ["presentation-worker"]
    },
    {
      "paths": [".template.config/presentation/**"],
      "tags": ["presentation-item"]
    },
    {
      "paths": [".template.config/starters/angular/**"],
      "tags": ["starter-angular"]
    },
    {
      "paths": [".template.config/starters/blazor-wasm/**"],
      "tags": ["starter-blazor-wasm"]
    },
    {
      "paths": [".template.config/variants/blazor-wasm-sign-in/**"],
      "tags": ["starter-blazor-wasm"]
    },
    {
      "paths": [".template.config/starters/react-router/**"],
      "tags": ["starter-react-router"]
    },
    {
      "paths": [".template.config/starters/vite-react/**"],
      "tags": ["starter-vite-react"]
    },
    {
      "paths": [".template.config/starters/vite-svelte/**"],
      "tags": ["starter-vite-svelte"]
    },
    {
      "paths": [".template.config/starters/vite-vue/**"],
      "tags": ["starter-vite-vue"]
    },
    {
      "paths": [
        "src/Web/**",
        ".github/workflows/web.yml",
        ".template.config/webapp/**",
        ".template.config/webpackage/**",
        ".template.config/variants/web-PlaceholderSite/**"
      ],
      "tags": ["web"]
    },
    {
      "paths": [
        ".template.config/variants/project/**",
        ".template.config/variants/no-client/**",
        ".template.config/variants/no-sonar/**",
        ".template.config/variants/no-sonar-no-client/**",
        ".template.config/variants/refused/**"
      ],
      "tags": ["all"]
    }
  ]
}
