<Project Sdk="Microsoft.NET.Sdk">

  <!-- Written as if it were a NuGet package, and vendored rather than published: a derived
       repository copies it and is free to tune it, which is why it carries no version. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>AppTemplate.Application.Core</PackageId>
    <Description>Application-layer mechanisms: results and errors, use-case markers, validation, pagination, idempotency, optimistic concurrency, and the cross-cutting ports a host has to satisfy.</Description>
    <Authors>AppTemplate contributors</Authors>
  </PropertyGroup>

  <!-- CS1591 is suppressed repository-wide, and re-enabled here: this is a deliberate public
       surface that a derived project reads instead of reading the code, so every public member
       owes it a sentence. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn.Replace('CS1591', ''))</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!-- Any change to the public surface is an explicit diff in PublicAPI.Unshipped.txt to review,
       rather than a side effect of an edit nobody read as one. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <!-- Never AppTemplate.Domain: the two files here that need a domain type — IDomainEventConsumer
       and DomainGuard — need only the primitives. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Domain\AppTemplate.Domain.Core\AppTemplate.Domain.Core.csproj" />
  </ItemGroup>

  <!-- Cursor.Decode, CursorKeys, SortTerm.Of and the other validating factories in
       Common/Collections/ are internal on purpose: nothing outside this assembly may construct one
       that skipped validation.
       A test restricted to the public surface could reach their failure branches only through a use
       case, which would prove a request is refused without showing which of a dozen branches refused
       it. Granted to exactly one assembly — this project's own mirror — for the same reason
       AppTemplate.Infrastructure.Persistence grants its mapper's internals to exactly one.

       Deliberately NOT granted to AppTemplate.Infrastructure.Persistence.UnitTests: a persistence
       test that could build an unvalidated SortOrder or Cursor would be asserting on SQL no request
       can produce. Those tests use the public Cursor.After and SortOrder.Parse instead. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>AppTemplate.Application.Core.UnitTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
