{
  "ConfigurationGuide": "Tracked in git and holding no secret: supply the blanks with `dotnet user-secrets` locally or environment variables when deployed (e.g. ConnectionStrings__Default); every section is validated at startup. See docs/reference/configuration.md.",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": ""
  },
  //#if (localAuth)
  "Jwt": {
    "Key": "",
    "Issuer": "",
    "Audience": "",
    "RequireHttpsMetadata": true,
    "AccessTokenLifetimeInMinutes": 15
  },
  "RefreshToken": {
    "LifetimeInDays": 7,
    "RetentionInDays": 7
  },
  "SecurityEventLog": {
    "RetentionInDays": 90,
    "PurgeBatchSize": 1000
  },
  "Identity": {
    "PasswordRequiredLength": 12,
    "PasswordRequiredUniqueChars": 4,
    "PasswordRequireDigit": true,
    "PasswordRequireLowercase": true,
    "PasswordRequireUppercase": true,
    "PasswordRequireNonAlphanumeric": true,
    "LockoutEnabled": true,
    "LockoutMaxFailedAccessAttempts": 5,
    "LockoutDurationInMinutes": 15,
    "RequireConfirmedEmail": true,
    "RequireUniqueEmail": true
  },
  //#endif
  //#if (files)
  "Files": {
    "Storage": {
      "Provider": "S3",
      "S3": {
        "BucketName": "",
        "Region": "us-east-1",
        "Endpoint": "",
        "PublicEndpoint": "",
        "ForcePathStyle": false,
        "AccessKeyId": "",
        "SecretAccessKey": "",
        "AllowInsecureTransport": false,
        "MaxGrantLifetime": "00:30:00"
      },
      "FileSystem": {
        "RootPath": ""
      }
    },
    "Scanning": {
      "Enabled": false,
      "Host": "",
      "Port": 3310,
      "MaxScannableBytes": 26214400
    },
    "ApiUploadMaxBytes": 10485760,
    "Categories": {
      "document": {
        "AllowedMediaTypes": [ "application/pdf", "text/csv", "text/plain" ],
        "MaxSizeInBytes": 52428800,
        "Scan": false,
        "VerifySignature": true,
        "Visibility": "Private",
        "UploadModes": [ "Direct", "Api" ],
        "Quota": {
          "Mode": "Strict",
          "MaxFiles": 1000,
          "MaxBytes": 10737418240,
          "MaxPendingUploads": 20
        }
      },
      "image": {
        "AllowedMediaTypes": [ "image/png", "image/jpeg", "image/webp" ],
        "MaxSizeInBytes": 10485760,
        "Scan": false,
        "VerifySignature": true,
        "Visibility": "Authenticated",
        "UploadModes": [ "Direct", "Api" ],
        "Quota": {
          "Mode": "Strict",
          "MaxFiles": 1000,
          "MaxBytes": 10737418240,
          "MaxPendingUploads": 20
        }
      }
    }
  },
  //#endif
  "Email": {
    "Transport": "Smtp",
    "Host": "",
    "Port": 587,
    "Security": "StartTls",
    "AllowInsecureTransport": false,
    "UserName": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "AppTemplate"
  },
  //#if (localAuth)
  "EmailConfirmation": {
    "ConfirmEmailUrl": ""
  },
  "PasswordReset": {
    "ResetPasswordUrl": "",
    "TokenLifespan": "01:00:00"
  },
  "EmailChange": {
    "ConfirmEmailChangeUrl": "",
    "TokenLifespan": "01:00:00"
  },
  "TwoFactor": {
    "ChallengeLifetime": "00:05:00",
    "RecoveryCodeCount": 10,
    "MaxChallengeAttempts": 5,
    "Issuer": "AppTemplate"
  },
  "Passkey": {
    "ServerDomain": null,
    "CeremonyLifetime": "00:05:00"
  },
  "IdentitySeed": {
    "Enabled": false,
    "AdminEmail": "",
    "AdminPassword": ""
  },
  //#endif
  "Jobs": {
    "Enabled": true,
    //#if (reminders)
    "Reminders": {
      "Interval": "00:01:00",
      "Enabled": true
    },
    //#endif
    //#if (files)
    "Files": {
      "PurgeAbandonedRegistrationsInterval": "01:00:00",
      "PurgeAbandonedRegistrationsEnabled": true,
      "ReclaimOrphanedContentInterval": "12:00:00",
      "ReclaimOrphanedContentEnabled": true,
      "InspectDepositedFilesInterval": "00:01:00",
      "InspectDepositedFilesEnabled": true
    },
    //#endif
    "Maintenance": {
      "Interval": "01:00:00",
      //#if (localAuth)
      "PurgeExpiredRefreshTokensEnabled": true,
      "PurgeExpiredSecurityEventsEnabled": true,
      //#endif
      //#if (anyFeature)
      "SweepDeletedAccountsDataEnabled": true,
      //#endif
      "PurgeExpiredIdempotencyKeysEnabled": true
    }
  },
  "OpenTelemetry": {
    "Enabled": false,
    "OtlpEndpoint": "",
    "OtlpProtocol": "Grpc",
    "ServiceName": null
  }
}
