{
  "$schema": "http://json.schemastore.org/template",
  "author": "AppTemplate contributors",
  "classifications": [
    "Web",
    "Clean Architecture"
  ],
  "identity": "AppTemplate.Templates.CleanArchitectureWebPackage",
  "name": ".NET Clean Architecture web package",
  "shortName": "cleanarch-webpackage",
  "description": "One more internal package in the pnpm workspace Src/Web of a project generated by cleanarch-webapi: source-exported TypeScript, with one exported function or component and its test. Run it at the project root.",
  "preferNameDirectory": false,
  "tags": {
    "language": "TypeScript",
    "type": "item"
  },
  "symbols": {
    "kind": {
      "type": "parameter",
      "datatype": "choice",
      "isRequired": true,
      "choices": [
        { "choice": "ts", "description": "Framework-agnostic TypeScript, usable by any app." },
        { "choice": "react", "description": "A React function component, for React apps only." },
        { "choice": "angular", "description": "An Angular standalone component, for Angular apps only." }
      ],
      "description": "What the package holds."
    },
    "scope": {
      "type": "parameter",
      "datatype": "text",
      "isRequired": true,
      "description": "The workspace's package scope without the @, as in Src/Web/package.json (for example acme-shop).",
      "replaces": "app-template"
    },
    "kindTs": { "type": "computed", "value": "(kind == \"ts\")" },
    "kindReact": { "type": "computed", "value": "(kind == \"react\")" },
    "kindAngular": { "type": "computed", "value": "(kind == \"angular\")" },
    "packageNameWords": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "name",
        "steps": [
          { "regex": "([A-Z]+)([A-Z][a-z])", "replacement": "$1-$2" },
          { "regex": "([a-z0-9])([A-Z])", "replacement": "$1-$2" },
          { "regex": "[.\\s_-]+", "replacement": "-" }
        ]
      }
    },
    "packageName": {
      "type": "generated",
      "generator": "casing",
      "parameters": { "source": "packageNameWords", "toLower": true },
      "replaces": "placeholder-package",
      "fileRename": "placeholder-package"
    }
  },
  "sources": [
    {
      "source": "./content/ts/",
      "target": "./Src/Web/packages/",
      "condition": "(kindTs)"
    },
    {
      "source": "./content/react/",
      "target": "./Src/Web/packages/",
      "condition": "(kindReact)"
    },
    {
      "source": "./content/angular/",
      "target": "./Src/Web/packages/",
      "condition": "(kindAngular)"
    }
  ],
  "postActions": [
    {
      "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
      "description": "Link the package into the workspace.",
      "manualInstructions": [
        {
          "text": "Run pnpm install in Src/Web, add \"@<scope>/<name>\": \"workspace:*\" to the dependencies of each app that uses it, and commit the lockfile with the package."
        }
      ],
      "continueOnError": true
    }
  ]
}
