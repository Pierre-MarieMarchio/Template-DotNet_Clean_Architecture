<?xml version="1.0" encoding="utf-8"?>
<!-- Filters are .NET regular expressions over full paths or type names: write a literal dot \. and a separator [\\/]. -->
<RunSettings>

  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage">
        <Configuration>
          <CodeCoverage>

            <!-- Test assemblies, also when one test project references another. -->
            <ModulePaths>
              <Exclude>
                <ModulePath>.*Tests\.dll$</ModulePath>
              </Exclude>
            </ModulePaths>

            <!-- Code a tool wrote: EF migrations, and every source generator's output under obj/. -->
            <Sources>
              <Exclude>
                <Source>.*[\\/]Migrations[\\/].*</Source>
                <Source>.*[\\/]obj[\\/].*</Source>
              </Exclude>
            </Sources>

            <!-- Compiler-synthesised members, and the explicit opt-out. -->
            <Attributes>
              <Exclude>
                <Attribute>^System\.Runtime\.CompilerServices\.CompilerGeneratedAttribute$</Attribute>
                <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
              </Exclude>
            </Attributes>

            <SkipAutoProps>true</SkipAutoProps>

            <IncludeTestAssembly>false</IncludeTestAssembly>

          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>

</RunSettings>
