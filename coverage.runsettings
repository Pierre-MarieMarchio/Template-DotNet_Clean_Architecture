<?xml version="1.0" encoding="utf-8"?>
<!-- Filters are .NET regular expressions over full paths or type names: write a literal dot \. and a separator [\\/]. -->
<RunSettings>

  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage">
        <Configuration>
          <CodeCoverage>

            <!-- Test assemblies, also when one test project references another. -->
            <ModulePaths>
              <Exclude>
                <ModulePath>.*tests\.dll$</ModulePath>
              </Exclude>
            </ModulePaths>

            <!-- Code a tool wrote, each anchored below the project: the collector matches a source's full path without case, so a bare folder name also matches the folder a project sits in. -->
            <Sources>
              <Exclude>
                <Source>.*[\\/]src[\\/]Infrastructure[\\/][^\\/]+[\\/]Migrations[\\/].*</Source>
                <Source>.*[\\/]obj[\\/][^\\/]+[\\/]net\d+\.\d+[^\\/]*[\\/].*</Source>
                <Source>.*[\\/]src[\\/]Presentation[\\/][^\\/]+\.Presentation\.Client[\\/]Generated[\\/].*</Source>
              </Exclude>
            </Sources>

            <!-- The explicit opt-out only: compiler-generated types hold every async, iterator and lambda body. -->
            <Attributes>
              <Exclude>
                <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
              </Exclude>
            </Attributes>

            <SkipAutoProps>true</SkipAutoProps>

            <IncludeTestAssembly>false</IncludeTestAssembly>

          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>

</RunSettings>
