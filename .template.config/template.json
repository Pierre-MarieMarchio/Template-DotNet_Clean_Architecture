{
  "$schema": "http://json.schemastore.org/template",
  "author": "Pierre-MarieMarchio",
  "classifications": [
    "Web",
    "WebAPI",
    "Clean Architecture",
    "DDD"
  ],
  "identity": "CleanArch.WebApi.CSharp",
  "groupIdentity": "CleanArch.WebApi",
  "name": ".NET Clean Architecture API",
  "shortName": "cleanarch-webapi",
  "description": "A .NET 10 HTTP API on Clean Architecture, meant to be kept: a domain, use cases, infrastructure modules behind ports and a thin presentation layer, on EF Core and PostgreSQL, with architecture tests, CI and its own documentation. Local accounts, an external OpenID Connect provider or no authentication; Files, the example features and a first web app are options.",
  "sourceName": "AppTemplate",
  "defaultName": "MyCompany.MyProject",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "symbols": {
    "auth": {
      "type": "parameter",
      "displayName": "Authentication",
      "datatype": "choice",
      "defaultValue": "local",
      "choices": [
        {
          "choice": "local",
          "description": "The supplied Auth module: local accounts, JWT access and refresh tokens, its own database context."
        },
        {
          "choice": "external",
          "description": "Accounts held by an external OpenID Connect provider (Keycloak, Entra ID, Auth0...): bearer tokens validated against Authentication:External, each subject mapped to an internal owner."
        },
        {
          "choice": "none",
          "description": "No accounts: a public API. Needs --examples none and --files false, whose features belong to a caller."
        }
      ],
      "description": "Who the API's callers are. none generates no Auth module and makes every endpoint public on purpose."
    },
    "authNoneNeedsExamplesNone": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        {
          "choice": "refused",
          "description": "Not an option to set: it names the refusal."
        }
      ],
      "isRequired": "(auth == \"none\" && examples != \"none\")",
      "description": "Never set. --auth none refuses the example features, which each belong to a caller: add --examples none."
    },
    "authNoneNeedsFilesFalse": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        {
          "choice": "refused",
          "description": "Not an option to set: it names the refusal."
        }
      ],
      "isRequired": "(auth == \"none\" && files)",
      "description": "Never set. --auth none refuses the Files module, whose files belong to a caller: add --files false."
    },
    "localAuth": {
      "type": "computed",
      "value": "(auth == \"local\")"
    },
    "externalAuth": {
      "type": "computed",
      "value": "(auth == \"external\")"
    },
    "publicApi": {
      "type": "computed",
      "value": "(auth == \"none\")"
    },
    "accounts": {
      "type": "computed",
      "value": "(localAuth || externalAuth)"
    },
    "refusedOptions": {
      "type": "computed",
      "value": "((auth == \"none\" && (examples != \"none\" || files)) || (web != \"none\" && webAudience == \"admin\" && auth == \"none\") || database == \"sqlserver\" || database == \"mysql\" || database == \"sqlite\")"
    },
    "database": {
      "type": "parameter",
      "displayName": "Database",
      "datatype": "choice",
      "defaultValue": "postgresql",
      "choices": [
        {
          "choice": "postgresql",
          "description": "PostgreSQL: a schema per feature, the row's xmin as its version, advisory locks for the leases."
        },
        {
          "choice": "sqlserver",
          "description": "SQL Server: a schema per feature, a version counter the save stamps, application locks for the leases."
        },
        {
          "choice": "mysql",
          "description": "MySQL 8.4: a table prefix per feature, a version counter the save stamps, named locks for the leases."
        },
        {
          "choice": "sqlite",
          "description": "SQLite, for development only: one file, a table prefix per feature, in-process leases; the API refuses to start outside Development."
        }
      ],
      "description": "The database the project runs on. A project carries that provider only; PostgreSQL is the one this version of the template generates."
    },
    "sqlServerNotYetGenerated": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        {
          "choice": "refused",
          "description": "Not an option to set: it names the refusal."
        }
      ],
      "isRequired": "(database == \"sqlserver\")",
      "description": "Never set. This version of the template does not generate --database sqlserver yet: choose --database postgresql."
    },
    "mySqlNotYetGenerated": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        {
          "choice": "refused",
          "description": "Not an option to set: it names the refusal."
        }
      ],
      "isRequired": "(database == \"mysql\")",
      "description": "Never set. This version of the template does not generate --database mysql yet: choose --database postgresql."
    },
    "sqliteNotYetGenerated": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        {
          "choice": "refused",
          "description": "Not an option to set: it names the refusal."
        }
      ],
      "isRequired": "(database == \"sqlite\")",
      "description": "Never set. This version of the template does not generate --database sqlite yet: choose --database postgresql."
    },
    "postgreSql": {
      "type": "computed",
      "value": "(database == \"postgresql\")"
    },
    "sqlServer": {
      "type": "computed",
      "value": "(database == \"sqlserver\")"
    },
    "mySql": {
      "type": "computed",
      "value": "(database == \"mysql\")"
    },
    "sqlite": {
      "type": "computed",
      "value": "(database == \"sqlite\")"
    },
    "tablePrefixes": {
      "type": "computed",
      "value": "(mySql || sqlite)"
    },
    "versionCounter": {
      "type": "computed",
      "value": "(!postgreSql)"
    },
    "serverDatabase": {
      "type": "computed",
      "value": "(!sqlite)"
    },
    "developmentConnectionString": {
      "type": "generated",
      "generator": "switch",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          { "condition": "(sqlServer)", "value": "Server=localhost,1433;Database=appdb;User Id=sa;Password=Local_dev_sa_1;TrustServerCertificate=True" },
          { "condition": "(mySql)", "value": "Server=localhost;Port=3306;Database=appdb;User=appuser;Password=appuser_local_dev" },
          { "condition": "(sqlite)", "value": "Data Source=App_Data/appdb.db" },
          { "condition": "(true)", "value": "Host=localhost;Port=5432;Database=appdb;Username=appuser;Password=appuser_local_dev;Include Error Detail=true;Gss Encryption Mode=Disable" }
        ]
      },
      "replaces": "Host=localhost;Port=5432;Database=appdb;Username=appuser;Password=appuser_local_dev;Include Error Detail=true;Gss Encryption Mode=Disable",
      "description": "The Default connection string of appsettings.Development.json, for the chosen database and the credentials .env.example gives it."
    },
    "templateMaintenance": {
      "type": "computed",
      "value": "false",
      "description": "Never true in a generated project. Names the pieces that maintain the template itself - the acceptance matrix, the test-count floor, the tree-auditing gates, the changelog - so they stay in the template repository only."
    },
    "templateVersion": {
      "type": "generated",
      "generator": "constant",
      "parameters": {
        "value": "1.0.0"
      },
      "replaces": "0.0.0-checkout",
      "description": "The template package's version, read by .template.config/TemplatePackage.csproj and recorded in a generated project's overview; a template-v<version> tag releases it."
    },
    "files": {
      "type": "parameter",
      "displayName": "Files module",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Include the Files module: stored files, their storage adapters, the object-store container and the Files tables of the business context."
    },
    "examples": {
      "type": "parameter",
      "displayName": "Example features",
      "datatype": "choice",
      "defaultValue": "all",
      "choices": [
        {
          "choice": "all",
          "description": "TodoLists, Reminders and Notes."
        },
        {
          "choice": "notes",
          "description": "Notes only: the simple example, with no domain model and no other feature to lean on."
        },
        {
          "choice": "none",
          "description": "No example feature: the modules, the mechanisms and their tests only."
        }
      ],
      "description": "Which example features the project starts with. Reminders needs TodoLists, so they come together."
    },
    "todoLists": {
      "type": "computed",
      "value": "(examples == \"all\")"
    },
    "reminders": {
      "type": "computed",
      "value": "(examples == \"all\")"
    },
    "notes": {
      "type": "computed",
      "value": "(examples == \"all\" || examples == \"notes\")"
    },
    "tagging": {
      "type": "computed",
      "value": "(todoLists || files)"
    },
    "aggregates": {
      "type": "computed",
      "value": "(todoLists || files)"
    },
    "anyFeature": {
      "type": "computed",
      "value": "(todoLists || reminders || notes || files)"
    },
    "canAddFeature": {
      "type": "computed",
      "value": "(localAuth || externalAuth)"
    },
    "signedInRoute": {
      "type": "computed",
      "value": "(localAuth || (externalAuth && anyFeature))"
    },
    "ci": {
      "type": "parameter",
      "displayName": "GitHub Actions workflows",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Include the GitHub Actions workflows that build, test, scan and release the solution (ci.yml, codeql.yml, release.yml; web.yml with a web app)."
    },
    "sonar": {
      "type": "parameter",
      "displayName": "Sonar analysis",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Include the Sonar analysis: the local SonarQube compose profile, its scanner image and task, and the SonarQube Cloud workflow when --ci is true."
    },
    "sonarWorkflow": {
      "type": "computed",
      "value": "(ci && sonar)"
    },
    "agentFiles": {
      "type": "parameter",
      "displayName": "Agent instructions",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Include AGENTS.md, the brief for coding agents and people, and Src/Web/AGENTS.md with a web app. It is the only agent file the template writes."
    },
    "web": {
      "type": "parameter",
      "displayName": "First web app",
      "datatype": "choice",
      "defaultValue": "none",
      "choices": [
        {
          "choice": "none",
          "description": "No web front end: the project stays a pure API."
        },
        {
          "choice": "placeholder",
          "description": "One web app holding a static page, served by nginx, relaying /api to the API."
        },
        {
          "choice": "react",
          "description": "One React (Vite, TypeScript) web app in the pnpm workspace Src/Web."
        },
        {
          "choice": "angular",
          "description": "One Angular web app in the pnpm workspace Src/Web."
        }
      ],
      "description": "The first web front end, in the pnpm workspace Src/Web. More apps are added later with dotnet new cleanarch-webapp."
    },
    "anyWeb": {
      "type": "computed",
      "value": "(web != \"none\")"
    },
    "webPlaceholder": {
      "type": "computed",
      "value": "(web == \"placeholder\")"
    },
    "webReact": {
      "type": "computed",
      "value": "(web == \"react\")"
    },
    "webAngular": {
      "type": "computed",
      "value": "(web == \"angular\")"
    },
    "browserSessions": {
      "type": "computed",
      "value": "(localAuth)"
    },
    "nameLower": {
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source": "name",
        "toLowerCase": true
      }
    },
    "kebabName": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "nameLower",
        "steps": [
          {
            "regex": "[.\\s_]+",
            "replacement": "-"
          }
        ]
      },
      "replaces": "app-template"
    },
    "webAudience": {
      "type": "parameter",
      "displayName": "Web app audience",
      "datatype": "choice",
      "defaultValue": "public",
      "choices": [
        { "choice": "public", "description": "A site for the API's users." },
        { "choice": "admin", "description": "A back office for administrators; needs --auth local or external." }
      ],
      "description": "Who the first web app is for; the framework apps shape their screens by it."
    },
    "adminAudience": { "type": "computed", "value": "(anyWeb && webAudience == \"admin\")" },
    "adminWebNeedsAccounts": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        {
          "choice": "refused",
          "description": "Not an option to set: it names the refusal."
        }
      ],
      "isRequired": "(web != \"none\" && webAudience == \"admin\" && auth == \"none\")",
      "description": "Never set. --web-audience admin signs administrators in, which --auth none cannot: choose --auth local or external."
    },
    "webName": {
      "type": "parameter",
      "displayName": "Web app name",
      "datatype": "text",
      "defaultValue": "Site",
      "description": "The first web app's name, in PascalCase: its folder Src/Web/apps/<name>, its service web-<name>, its port WEB_<NAME>_HOST_PORT.",
      "replaces": "PlaceholderSite",
      "fileRename": "PlaceholderSite"
    },
    "webNameWords": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "webName",
        "steps": [
          { "regex": "([A-Z]+)([A-Z][a-z])", "replacement": "$1-$2" },
          { "regex": "([a-z0-9])([A-Z])", "replacement": "$1-$2" },
          { "regex": "[.\\s_-]+", "replacement": "-" }
        ]
      }
    },
    "webNameKebab": {
      "type": "generated",
      "generator": "casing",
      "parameters": { "source": "webNameWords", "toLower": true },
      "replaces": "placeholder-site"
    },
    "webNameUpper": {
      "type": "generated",
      "generator": "casing",
      "parameters": { "source": "webNameWords", "toLower": false }
    },
    "webNameEnvironment": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "webNameUpper",
        "steps": [{ "regex": "-", "replacement": "_" }]
      },
      "replaces": "PLACEHOLDER_SITE"
    },
    "webNameReact": {
      "type": "derived",
      "valueSource": "webName",
      "valueTransform": "identity",
      "replaces": "ReactSite",
      "fileRename": "ReactSite"
    },
    "webNameKebabReact": {
      "type": "generated",
      "generator": "casing",
      "parameters": { "source": "webNameWords", "toLower": true },
      "replaces": "react-site"
    },
    "webNameEnvironmentReact": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "webNameUpper",
        "steps": [{ "regex": "-", "replacement": "_" }]
      },
      "replaces": "REACT_SITE"
    },
    "webNameAngular": {
      "type": "derived",
      "valueSource": "webName",
      "valueTransform": "identity",
      "replaces": "AngularSite",
      "fileRename": "AngularSite"
    },
    "webNameKebabAngular": {
      "type": "generated",
      "generator": "casing",
      "parameters": { "source": "webNameWords", "toLower": true },
      "replaces": "angular-site"
    },
    "webNameEnvironmentAngular": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "webNameUpper",
        "steps": [{ "regex": "-", "replacement": "_" }]
      },
      "replaces": "ANGULAR_SITE"
    },
    "webDefaultPort": {
      "type": "generated",
      "generator": "switch",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          { "condition": "(webReact)", "value": "5173" },
          { "condition": "(webAngular)", "value": "4200" },
          { "condition": "(true)", "value": "8081" }
        ]
      }
    },
    "webPortReference": {
      "type": "generated",
      "generator": "join",
      "parameters": {
        "symbols": [
          { "type": "const", "value": "${WEB_" },
          { "type": "ref", "value": "webNameEnvironment" },
          { "type": "const", "value": "_HOST_PORT:-" },
          { "type": "ref", "value": "webDefaultPort" },
          { "type": "const", "value": "}" }
        ],
        "separator": ""
      },
      "replaces": "${WEB_PLACEHOLDER_SITE_HOST_PORT:-8081}"
    },
    "webPortSetting": {
      "type": "generated",
      "generator": "join",
      "parameters": {
        "symbols": [
          { "type": "const", "value": "WEB_" },
          { "type": "ref", "value": "webNameEnvironment" },
          { "type": "const", "value": "_HOST_PORT=" },
          { "type": "ref", "value": "webDefaultPort" }
        ],
        "separator": ""
      },
      "replaces": "WEB_PLACEHOLDER_SITE_HOST_PORT=8081"
    }
  },
