# Copy to .env (git-ignored) for docker-compose.yml; every default works on localhost, so change them all before sharing the stack.
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=appuser_local_dev
# Bound to 127.0.0.1, for a database client on this machine.
POSTGRES_HOST_PORT=5432

# API
ASPNETCORE_ENVIRONMENT=Development
API_HOST_PORT=8080

#if (anyWeb)
# Web apps, loopback only: one port per app, named after its folder.
#if (webPlaceholder)
WEB_PLACEHOLDER_SITE_HOST_PORT=8081
#endif

#endif
# Mailpit host ports, loopback only: the web UI is where the mails land.
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

#if (localAuth)
# Jwt section. Replace the key with at least 32 bytes: openssl rand -base64 48
JWT_KEY=dev-only-signing-key-not-for-production-replace-me-0123456789ab
JWT_ISSUER=AppTemplate.Api.Development
JWT_AUDIENCE=AppTemplate.Client.Development
JWT_REQUIRE_HTTPS_METADATA=false
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60

#endif
#if (externalAuth)
# Authentication:External section: your OpenID Connect provider's issuer URL and this API's identifier there, both required.
EXTERNAL_AUTH_AUTHORITY=
EXTERNAL_AUTH_AUDIENCE=
EXTERNAL_AUTH_REQUIRE_HTTPS_METADATA=true
# Local reads roles from external_identity.RoleAssignments; Claim reads them from the token at the claim path.
EXTERNAL_AUTH_ROLES_SOURCE=Local
EXTERNAL_AUTH_ROLES_CLAIM_PATH=
EXTERNAL_AUTH_ADMINISTRATOR_ROLE=Admin

#endif
#if (files)
# Files:Storage:S3 section, for the local SeaweedFS; in production leave both credentials empty and use an instance role.
STORAGE_BUCKET_NAME=app-files
STORAGE_ENDPOINT=http://objectstore:9000
# The name your browser resolves, signed into every presigned URL; change it together with OBJECT_STORE_HOST_PORT.
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORE_HOST_PORT=9000
STORAGE_FORCE_PATH_STYLE=true
STORAGE_ALLOW_INSECURE_TRANSPORT=true
STORAGE_ACCESS_KEY_ID=app-template-dev
STORAGE_SECRET_ACCESS_KEY=app-template-dev-secret

#endif
#if (localAuth)
# RefreshToken section
REFRESH_TOKEN_LIFETIME_DAYS=7

# Identity section: password, lockout and sign-in policy; the password length has a floor of 8.
IDENTITY_PASSWORD_LENGTH=8
IDENTITY_PASSWORD_UNIQUE_CHARS=1
IDENTITY_PASSWORD_REQUIRE_DIGIT=false
IDENTITY_PASSWORD_REQUIRE_LOWERCASE=false
IDENTITY_PASSWORD_REQUIRE_UPPERCASE=false
IDENTITY_PASSWORD_REQUIRE_NONALPHANUMERIC=false
IDENTITY_LOCKOUT_ENABLED=true
IDENTITY_LOCKOUT_MAX_ATTEMPTS=10
IDENTITY_LOCKOUT_DURATION_MINUTES=1
IDENTITY_REQUIRE_CONFIRMED_EMAIL=true
IDENTITY_REQUIRE_UNIQUE_EMAIL=true

#endif
# Email section, aimed at the mailpit service; for a real relay use StartTls or SslOnConnect and set the opt-in to false.
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_SECURITY=None
EMAIL_ALLOW_INSECURE_TRANSPORT=true
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=no-reply@localhost
EMAIL_FROM_NAME=AppTemplate (dev)

# The language of a mail whose reader has not said which one they read.
LOCALIZATION_DEFAULT_CULTURE=en

#if (localAuth)
# The pages that complete each mailed link: absolute http/https URLs a browser reaches, with no fragment.
CONFIRM_EMAIL_URL=http://localhost:${WEB_PLACEHOLDER_SITE_HOST_PORT:-8081}/confirm-email
RESET_PASSWORD_URL=http://localhost:${WEB_PLACEHOLDER_SITE_HOST_PORT:-8081}/reset-password
CONFIRM_EMAIL_CHANGE_URL=http://localhost:${WEB_PLACEHOLDER_SITE_HOST_PORT:-8081}/confirm-email-change

#endif
# Database section; keep replicas x pool size under the server's max_connections.
DATABASE_MAX_POOL_SIZE=20
DATABASE_COMMAND_TIMEOUT_SECONDS=30

# Idempotency purge
IDEMPOTENCY_PURGE_BATCH_SIZE=1000

# Background jobs: false on an instance that only serves HTTP; with several instances, true on exactly one.
JOBS_ENABLED=true

# Maintenance job: the purges, on one interval.
JOBS_MAINTENANCE_INTERVAL=01:00:00
JOBS_MAINTENANCE_PURGE_IDEMPOTENCY_KEYS=true
#if (localAuth)
JOBS_MAINTENANCE_PURGE_REFRESH_TOKENS=true
#endif

#if (reminders)
# Reminder job: false stops the reminder mail and keeps the rest of the process running.
JOBS_REMINDERS_INTERVAL=00:01:00
JOBS_REMINDERS_ENABLED=true
#endif

#if (files)
# File jobs: shorten the inspection while working on Files; turning inspection or reclaim off stops the feature or leaks storage.
JOBS_FILES_INSPECT_INTERVAL=00:01:00
JOBS_FILES_INSPECT_ENABLED=true
JOBS_FILES_PURGE_INTERVAL=01:00:00
JOBS_FILES_PURGE_ENABLED=true
JOBS_FILES_RECLAIM_INTERVAL=12:00:00
JOBS_FILES_RECLAIM_ENABLED=true

#endif
#if (localAuth)
# IdentitySeed section, development only: enabling it requires a password; never enable it where the internet reaches.
SEED_ENABLED=false
SEED_ADMIN_EMAIL=administrator@localhost
SEED_ADMIN_PASSWORD=

#endif
# Cors
CORS_ALLOWED_ORIGIN_0=http://localhost:4200
#if (sonar)

# Local Sonar analysis only: generate the token at http://localhost:9111 under My Account > Security.
SONAR_TOKEN=
SONAR_PROJECT_KEY=app-template
#endif
