{
  "ConfigurationGuide": "Development overrides with localhost throwaway values, loaded only when ASPNETCORE_ENVIRONMENT=Development; anything secret belongs in `dotnet user-secrets`.",
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "ConnectionStrings": {
    //#if (sqlite)
    "Default": "Data Source=../AppTemplate.Api/App_Data/appdb.db"
    //#else
    "Default": "Host=localhost;Port=5432;Database=appdb;Username=appuser;Password=appuser_local_dev;Include Error Detail=true;Gss Encryption Mode=Disable"
    //#endif
  },
  //#if (localAuth)
  "Jwt": {
    "Key": "dev-only-signing-key-not-for-production-replace-me-0123456789ab",
    "Issuer": "AppTemplate.Api.Development",
    "Audience": "AppTemplate.Client.Development",
    "RequireHttpsMetadata": false,
    "AccessTokenLifetimeInMinutes": 60
  },
  "RefreshToken": {
    "LifetimeInDays": 7
  },
  "Identity": {
    "PasswordRequiredLength": 8,
    "PasswordRequiredUniqueChars": 4,
    "PasswordRequireDigit": true,
    "PasswordRequireLowercase": true,
    "PasswordRequireUppercase": true,
    "PasswordRequireNonAlphanumeric": true,
    "LockoutEnabled": true,
    "LockoutMaxFailedAccessAttempts": 10,
    "LockoutDurationInMinutes": 5,
    "RequireConfirmedEmail": true,
    "RequireUniqueEmail": true
  },
  //#endif
  //#if (localAuth)
  "EmailConfirmation": {
    "ConfirmEmailUrl": "http://localhost:5190/confirm-email"
  },
  "PasswordReset": {
    "ResetPasswordUrl": "http://localhost:5190/reset-password"
  },
  "EmailChange": {
    "ConfirmEmailChangeUrl": "http://localhost:5190/confirm-email-change"
  },
  "IdentitySeed": {
    "Enabled": false,
    "AdminEmail": "administrator@localhost",
    "AdminPassword": ""
  },
  //#endif
  "Email": {
    "Host": "localhost",
    "Port": 1025,
    "Security": "None",
    "AllowInsecureTransport": false,
    "UserName": "",
    "Password": "",
    "FromAddress": "no-reply@localhost",
    "FromName": "AppTemplate (dev)"
  }
}
