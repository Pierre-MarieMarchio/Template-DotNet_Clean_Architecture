{
  "$schema": "http://json.schemastore.org/template",
  "author": "AppTemplate contributors",
  "classifications": [
    "Web",
    "Clean Architecture"
  ],
  "identity": "AppTemplate.Templates.CleanArchitectureWebApp",
  "name": ".NET Clean Architecture web app",
  "shortName": "cleanarch-webapp",
  "description": "One more web app in the pnpm workspace Src/Web of a project generated by cleanarch-webapi: its own folder, nginx image and Compose service, relaying /api to the API. Run it at the project root.",
  "preferNameDirectory": false,
  "tags": {
    "language": "TypeScript",
    "type": "item"
  },
  "symbols": {
    "framework": {
      "type": "parameter",
      "datatype": "choice",
      "isRequired": true,
      "choices": [
        { "choice": "placeholder", "description": "A static page served by nginx, relaying /api to the API." },
        { "choice": "react", "description": "A React app, created by Vite's official CLI (create-vite, react-ts) when web-scaffold runs." },
        { "choice": "angular", "description": "An Angular app, created by the Angular CLI (ng new) when web-scaffold runs." }
      ],
      "description": "The app's framework."
    },
    "audience": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "public",
      "choices": [
        { "choice": "public", "description": "A site for the API's users." },
        { "choice": "admin", "description": "A back office for administrators; needs an API that authenticates." }
      ],
      "description": "Who the app is for; the framework apps shape their screens by it."
    },
    "scope": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "isRequired": "(framework != \"placeholder\")",
      "description": "The workspace's package scope without the @, as in Src/Web/package.json (for example acme-shop): a framework app depends on @<scope>/api-client.",
      "replaces": "app-template"
    },
    "port": {
      "type": "parameter",
      "datatype": "integer",
      "defaultValue": "8082",
      "description": "The app's default host port on 127.0.0.1, overridden by WEB_<NAME>_HOST_PORT in .env.",
      "replaces": "8081"
    },
    "auth": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "local",
      "choices": [
        { "choice": "local", "description": "The project was generated with --auth local." },
        { "choice": "external", "description": "The project was generated with --auth external." },
        { "choice": "none", "description": "The project was generated with --auth none." }
      ],
      "description": "The project's --auth value: the app's sign-in screens follow it."
    },
    "examples": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "all",
      "choices": [
        { "choice": "all", "description": "The project was generated with --examples all." },
        { "choice": "notes", "description": "The project was generated with --examples notes." },
        { "choice": "none", "description": "The project was generated with --examples none." }
      ],
      "description": "The project's --examples value: the app has one page per example feature."
    },
    "adminNeedsAccounts": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        { "choice": "refused", "description": "Not an option to set: it names the refusal." }
      ],
      "isRequired": "(audience == \"admin\" && auth == \"none\")",
      "description": "Never set. --audience admin signs administrators in, which --auth none cannot."
    },
    "localAuth": { "type": "computed", "value": "(auth == \"local\")" },
    "externalAuth": { "type": "computed", "value": "(auth == \"external\")" },
    "publicApi": { "type": "computed", "value": "(auth == \"none\")" },
    "accounts": { "type": "computed", "value": "(localAuth || externalAuth)" },
    "browserSessions": { "type": "computed", "value": "(localAuth)" },
    "todoLists": { "type": "computed", "value": "(examples == \"all\")" },
    "notes": { "type": "computed", "value": "(examples == \"all\" || examples == \"notes\")" },
    "anyWeb": { "type": "computed", "value": "true" },
    "webPlaceholder": { "type": "computed", "value": "(framework == \"placeholder\")" },
    "webReact": { "type": "computed", "value": "(framework == \"react\")" },
    "webAngular": { "type": "computed", "value": "(framework == \"angular\")" },
    "adminAudience": { "type": "computed", "value": "(audience == \"admin\")" },
    "appName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "identity",
      "replaces": "PlaceholderSite",
      "fileRename": "PlaceholderSite"
    },
    "appNameReact": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "identity",
      "replaces": "ReactSite",
      "fileRename": "ReactSite"
    },
    "appNameAngular": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "identity",
      "replaces": "AngularSite",
      "fileRename": "AngularSite"
    },
    "appNameWords": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "name",
        "steps": [
          { "regex": "([A-Z]+)([A-Z][a-z])", "replacement": "$1-$2" },
          { "regex": "([a-z0-9])([A-Z])", "replacement": "$1-$2" },
          { "regex": "[.\\s_-]+", "replacement": "-" }
        ]
      }
    },
    "appNameKebab": {
      "type": "generated",
      "generator": "casing",
      "parameters": { "source": "appNameWords", "toLower": true },
      "replaces": "placeholder-site"
    },
    "appNameUpper": {
      "type": "generated",
      "generator": "casing",
      "parameters": { "source": "appNameWords", "toLower": false }
    },
    "appNameEnvironment": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "appNameUpper",
        "steps": [{ "regex": "-", "replacement": "_" }]
      },
      "replaces": "PLACEHOLDER_SITE"
    },
    "appNameKebabReact": {
      "type": "generated",
      "generator": "casing",
      "parameters": { "source": "appNameWords", "toLower": true },
      "replaces": "react-site"
    },
    "appNameEnvironmentReact": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "appNameUpper",
        "steps": [{ "regex": "-", "replacement": "_" }]
      },
      "replaces": "REACT_SITE"
    },
    "appNameKebabAngular": {
      "type": "generated",
      "generator": "casing",
      "parameters": { "source": "appNameWords", "toLower": true },
      "replaces": "angular-site"
    },
    "appNameEnvironmentAngular": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "appNameUpper",
        "steps": [{ "regex": "-", "replacement": "_" }]
      },
      "replaces": "ANGULAR_SITE"
    },
    "reactPort": {
      "type": "generated",
      "generator": "join",
      "parameters": {
        "symbols": [{ "type": "ref", "value": "port" }],
        "separator": ""
      },
      "replaces": "5173"
    },
    "angularPort": {
      "type": "generated",
      "generator": "join",
      "parameters": {
        "symbols": [{ "type": "ref", "value": "port" }],
        "separator": ""
      },
      "replaces": "4200"
    }
  },
  "sources": [
    {
      "source": "../../Src/Web/apps/",
      "target": "./Src/Web/apps/",
      "modifiers": [
        {
          "exclude": [
            "**/node_modules/**",
            "**/dist/**",
            "**/coverage/**"
          ]
        },
        {
          "condition": "(!webPlaceholder)",
          "exclude": [
            "PlaceholderSite/**"
          ]
        },
        {
          "condition": "(!webReact)",
          "exclude": [
            "ReactSite/**"
          ]
        },
        {
          "condition": "(!webAngular)",
          "exclude": [
            "AngularSite/**"
          ]
        }
      ]
    }
  ],
  "postActions": [
    {
      "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
      "description": "Start the app with the rest of the stack.",
      "manualInstructions": [
        {
          "text": "In docker-compose.yml, add '  - path: Src/Web/apps/<name>/compose.yml' under include:, and add WEB_<NAME>_HOST_PORT to .env.example; Src/Web/apps/<name>/README.md gives both lines. A react or angular app is created by its official CLI: run dotnet run Tools/Tasks.cs web-scaffold <name> at the project root (or bootstrap), then commit the app with Src/Web/pnpm-lock.yaml. A placeholder needs only pnpm install in Src/Web."
        }
      ],
      "continueOnError": true
    }
  ]
}
