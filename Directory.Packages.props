<Project>

  <!-- Every version is declared here once; projects reference packages without a Version. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Runtime — all Microsoft.* on the same 10.0.x band">
    <!--#if (!publicApi)-->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <!--#endif-->
    <!--#if (presentationBlazorServer && externalAuth)-->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.14" />
    <!--#endif-->
    <!--#if (localAuth)-->
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <!--#endif-->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <!--#if (sqlServer)-->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <!--#endif-->
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.14" />
    <!-- For a module that registers a typed client without referencing ASP.NET Core. -->
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
  </ItemGroup>

  <!--#if (localAuth)-->
  <ItemGroup Label="Identity model">
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
  </ItemGroup>
  <!--#endif-->

  <!-- Its own 10.9.x band; Polly comes transitively, at the version this package chose. -->
  <ItemGroup Label="Outbound HTTP">
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
  </ItemGroup>

  <!--#if (dotnetClient)-->
  <!-- The version the pinned Kiota tool generates for; the two move together. -->
  <ItemGroup Label="API client">
    <PackageVersion Include="Microsoft.Kiota.Bundle" Version="2.1.2" />
  </ItemGroup>

  <!--#endif-->
  <!--#if (webBlazorWasm)-->
  <ItemGroup Label="Web app on WebAssembly">
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <!--#if (externalAuth)-->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="10.0.14" />
    <!--#endif-->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" />
  </ItemGroup>

  <!--#endif-->
  <!--#if (presentationAvalonia)-->
  <!-- One Avalonia 12.1.x band, the version Avalonia.Templates writes. -->
  <!--#endif-->
  <!--#if (presentationAvalonia || presentationWpf)-->
  <ItemGroup Label="Desktop presentation">
  <!--#endif-->
  <!--#if (presentationAvalonia)-->
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
  <!--#endif-->
  <!--#if (presentationAvalonia || presentationWpf)-->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!--#if (externalAuth)-->
    <PackageVersion Include="Duende.IdentityModel.OidcClient" Version="7.1.0" />
    <!--#endif-->
  </ItemGroup>

  <!--#endif-->
  <!--#if (presentationMcp)-->
  <ItemGroup Label="MCP server">
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
  </ItemGroup>

  <!--#endif-->
  <!-- One 1.18.x band. -->
  <ItemGroup Label="OpenTelemetry">
    <!--#if (postgreSql)-->
    <!-- Npgsql.OpenTelemetry follows the EF provider's version. -->
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="10.0.3" />
    <!--#endif-->
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <!--#if (sqlServer)-->
    <PackageVersion Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.20.1" />
    <!--#endif-->
  </ItemGroup>

  <!--#if (files)-->
  <!-- AWSSDK.S3 only: the client is built from the module's own validated options. -->
  <ItemGroup Label="Object storage">
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104.8" />
  </ItemGroup>

  <!--#endif-->
  <!-- Overrides a version a package asks for. Drop the entry once MailKit requires System.Security.Cryptography.Pkcs 10.0.14 or later. -->
  <ItemGroup Label="Transitive pins">
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="Third-party runtime">
    <PackageVersion Include="Asp.Versioning.Mvc" Version="10.2.1" />
    <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageVersion Include="MailKit" Version="4.18.2" />
    <!--#if (postgreSql)-->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!--#endif-->
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.5" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <!-- The in-process relational provider the saving-pipeline tests run on. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <!--#if (files)-->
    <!--#if (serverDatabase)-->
    <!-- Keep on the same version as the Testcontainers database module, which pins this core exactly. -->
    <!--#endif-->
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
    <!--#endif-->
    <!--#if (sqlServer)-->
    <PackageVersion Include="Testcontainers.MsSql" Version="4.15.0" />
    <!--#endif-->
    <!--#if (mySql)-->
    <PackageVersion Include="Testcontainers.MySql" Version="4.15.0" />
    <!--#endif-->
    <!--#if (postgreSql)-->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <!--#endif-->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

</Project>
