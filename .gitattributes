# Normalise line endings: authored on Windows, built in Linux containers.
* text=auto eol=lf

*.cs        text eol=lf diff=csharp
*.csproj    text eol=lf
*.sln       text eol=crlf
*.slnx      text eol=lf
*.props     text eol=lf
*.targets   text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.sh        text eol=lf
Dockerfile  text eol=lf
*.ps1       text eol=crlf

*.png binary
*.jpg binary
*.ico binary
*.pfx binary
*.snk binary
