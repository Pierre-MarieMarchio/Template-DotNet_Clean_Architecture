{
  "framework": "react",
  "name": "framework-site",
  "package": "create-react-router",
  "version": "8.5.0",
  "arguments": [
    "{directory}",
    "--template", "https://github.com/remix-run/react-router-templates/tree/067adb378a00a4c2ceb71934d5e8901d0e87c256/default",
    "--no-install", "--no-git-init", "--no-agent-skills", "--yes"
  ],
  "remove": ["Dockerfile", ".dockerignore"],
  "merge": {
    "package.json": {
      "name": "framework-site",
      "scripts": {
        "start": null,
        "test": "vitest run --passWithNoTests"
      },
      "dependencies": {
        "@app-template/api-client": "workspace:*",
        "@react-router/serve": null
      },
      "devDependencies": {
        "vitest": "5.0.5"
      }
    },
    "tsconfig.json": {
      "compilerOptions": {
        "allowImportingTsExtensions": true
      }
    }
  }
}
