<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for the API host's own logic: the cross-cutting HTTP mechanisms under Common —
       ProblemDetails normalisation, ETag encoding, If-Match parsing, the ApiControllerBase
       primitives, the option validators and the rate-limit counters — and the feature mappings and
       controllers. All pure or near-pure decisions that run in microseconds and do not need a live
       HTTP pipeline to verify. The one assembly the API's internals are granted to. -->

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Not Sdk="Microsoft.NET.Sdk.Web": this project asserts on types, not on a running server, so
         it only needs the ASP.NET Core types themselves, not the hosting model. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- For Composition/: the host composes both persistence contexts, so whether a save on one can
         flush or publish the other's work is checked here, against real contexts and real commits.
         SQLite rather than PostgreSQL because these must run where no container runtime does; the
         same scenarios run against PostgreSQL in AppTemplate.Api.IntegrationTests. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Src\Application\AppTemplate.Application\AppTemplate.Application.csproj" />
    <ProjectReference Include="..\..\..\Src\Presentation\AppTemplate.Api\AppTemplate.Api.csproj" />
  </ItemGroup>

</Project>
