<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!-- The template's proof that Clean Architecture pays for itself: a second entry point that
       calls the same application-layer use cases as AppTemplate.Api, through the same
       infrastructure modules, with no use case and no domain type changed. It hosts one
       BackgroundService and nothing business-shaped lives here. -->

  <PropertyGroup>
    <UserSecretsId>74620b17-71c0-43e0-a45a-69dae1e68a32</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..\..</DockerfileContext>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- Not pulled in transitively: unlike AppTemplate.Api, this host does not reference the
         ASP.NET Core shared framework, so the console logging provider needs its own reference. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <!-- Same OpenTelemetry SDK band as AppTemplate.Api (Directory.Packages.props), minus the two
       ASP.NET Core instrumentations: this host has no inbound request and no outbound HTTP call to
       instrument. Npgsql.OpenTelemetry supplies the .AddNpgsql() tracing extension the same way it
       does for the Api host. -->
  <ItemGroup>
    <PackageReference Include="Npgsql.OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
  </ItemGroup>

  <!-- The same modules AppTemplate.Api composes for these use cases, and no reference to
       AppTemplate.Api itself — the whole point is that this host needs none of it.
       AppTemplate.Infrastructure.Email is composed for one port: a reminder that comes due is
       rung by mail, and IReminderNotifier's adapter lives there.
       AppTemplate.Infrastructure.Identity is here only because IRefreshTokenMaintenance's sole
       adapter lives there; composing it also pulls in JWT and ASP.NET Identity's own configuration
       surface, which is why this project's appsettings.json carries the same
       Jwt/Identity/RefreshToken/EmailConfirmation sections as the API even though this host never
       authenticates anybody. See docs/CONFIGURATION.md. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Application\AppTemplate.Application\AppTemplate.Application.csproj" />
    <ProjectReference Include="..\..\Infrastructure\AppTemplate.Infrastructure.Persistence\AppTemplate.Infrastructure.Persistence.csproj" />
    <ProjectReference Include="..\..\Infrastructure\AppTemplate.Infrastructure.Identity\AppTemplate.Infrastructure.Identity.csproj" />
    <ProjectReference Include="..\..\Infrastructure\AppTemplate.Infrastructure.Email\AppTemplate.Infrastructure.Email.csproj" />
  </ItemGroup>

  <!-- The loop's resilience and its use of the stopping token are the whole point of this
       project; testing them from outside would mean testing Program.cs's composition instead
       of the behaviour itself. Shared with exactly one assembly, same as the persistence
       project's InternalsVisibleTo. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>AppTemplate.Worker.UnitTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <DependentUpon>appsettings.json</DependentUpon>
    </None>
  </ItemGroup>

</Project>
