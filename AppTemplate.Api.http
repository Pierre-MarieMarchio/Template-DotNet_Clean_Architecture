####################################################################################################
# End-to-end walkthrough of the API, in dependency order.
#
# Prerequisites
#   docker compose up -d db mailpit
#   dotnet run --project Src/Presentation/AppTemplate.Api
#
# Run the requests top to bottom. Every value a later request needs is captured from an earlier
# response, except the email confirmation token: it arrives by mail, and this file format has no way
# to pull a substring out of a message body. Request 4 fetches the mail so you can read the token;
# paste it into @confirmationToken and carry on. That step is marked MANUAL below.
#
# Works in the VS Code REST Client extension and in Visual Studio's .http editor. Both resolve
# {{requestName.response.body.$.field}} against a named earlier response.
####################################################################################################

@host = http://localhost:5187
@api = {{host}}/api/v1
@mailpit = http://localhost:8025

# Password satisfies appsettings.Development.json: >= 8 chars, upper, lower, digit, non-alphanumeric.
@userName = ada
@email = ada@localhost
@password = Str0ng!Passw0rd
@newPassword = {{password}}-2
@resetPassword = {{password}}-3

###
# 1. Register. The account is committed before the mail is handed to the relay, so
#    confirmationEmailSent=false means "use the resend endpoint", not "sign-up failed".
# @name register
POST {{api}}/auth/register
Content-Type: application/json

{
  "userName": "{{userName}}",
  "email": "{{email}}",
  "password": "{{password}}"
}

###
# 2. Registering the same address again is a 409 with a stable machine-readable `code`,
#    not a 500. Expected to fail — it is here to show the shape of a ProblemDetails body.
POST {{api}}/auth/register
Content-Type: application/json

{
  "userName": "{{userName}}",
  "email": "{{email}}",
  "password": "{{password}}"
}

###
# 3. Logging in before confirmation is refused: Identity:RequireConfirmedEmail is true.
POST {{api}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

###
# 4. MANUAL STEP. Read the confirmation mail out of mailpit and copy the `token` query
#    parameter of the confirm-email link into @confirmationToken below.
#    The browser UI at http://localhost:8025 shows the same message.
# @name confirmationMail
GET {{mailpit}}/api/v1/message/latest
Accept: application/json

###
# Paste the token from request 4 here.
@confirmationToken = paste-the-token-from-request-4

###
# 5. Confirm the address. POST with a JSON body, deliberately not GET with a query string:
#    a single-use token must not land in access logs, browser history or a Referer header.
POST {{api}}/auth/confirm-email
Content-Type: application/json

{
  "email": "{{email}}",
  "token": "{{confirmationToken}}"
}

###
# 6. Resend the confirmation mail. Answers 204 even for an address that does not exist,
#    so the endpoint cannot be used to enumerate accounts.
POST {{api}}/auth/resend-confirmation-email
Content-Type: application/json

{
  "email": "{{email}}"
}

###
# 7. Log in. Captures the access token and the refresh token for everything below.
# @name login
POST {{api}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

###
# The body is a discriminated union: `status` says which outcome it is, and the pair lives under
# `tokens` so that /auth/refresh can answer with the same object.
@accessToken = {{login.response.body.$.tokens.accessToken}}
@refreshToken = {{login.response.body.$.tokens.refreshToken}}

###
# 7b. The caller's own profile. The only endpoint that publishes an account: neither register nor
#     login returns one, so a client reads it here once it holds a token.
GET {{api}}/auth/me
Authorization: Bearer {{accessToken}}

###
# 8. Without a token: 401. The application's fallback policy requires an authenticated user,
#    so an endpoint is protected unless it opts out.
GET {{api}}/todo-lists

###
# 9. Create a list. 201 with the created list as the body, its ETag, and a Location header pointing
#    at request 11 — so a client can go straight on to a conditional write without reading first.
# @name createList
POST {{api}}/todo-lists
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Groceries"
}

###
@todoListId = {{createList.response.body.$.id}}

###
# 10. Add an item, with tags.
# @name addItem
POST {{api}}/todo-lists/{{todoListId}}/items
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "Buy milk",
  "description": "Semi-skimmed, two litres",
  "tags": ["errand", "dairy"]
}

###
@todoItemId = {{addItem.response.body.$.id}}

###
# 11. Read the list back. The item added above is present, with its audit stamps. The response
#     carries a strong, quoted ETag: the version this list is at, opaque to the caller.
# @name readList
GET {{api}}/todo-lists/{{todoListId}}
Authorization: Bearer {{accessToken}}

###
@todoListETag = {{readList.response.headers.ETag}}

###
# 12. Read the single item. Its ETag is the list's — the list is the aggregate, so there is no
#     separate version for one item inside it.
GET {{api}}/todo-lists/{{todoListId}}/items/{{todoItemId}}
Authorization: Bearer {{accessToken}}

###
# 13. Rename the list conditionally, naming the version read in request 11. Applied because
#     nothing has changed it since: 200, with the renamed list and the ETag it is now at.
PUT {{api}}/todo-lists/{{todoListId}}
Authorization: Bearer {{accessToken}}
If-Match: {{todoListETag}}
Content-Type: application/json

{
  "name": "Groceries (this week)"
}

###
# 14. Replay request 13 with the same If-Match. The rename above already moved the list past that
#     version, so this one is refused: 412 with a ProblemDetails body carrying
#     "code": "precondition.failed". Read the list again to retry with the current ETag.
PUT {{api}}/todo-lists/{{todoListId}}
Authorization: Bearer {{accessToken}}
If-Match: {{todoListETag}}
Content-Type: application/json

{
  "name": "Too late"
}

###
# 15. Complete the item. 200 with the completed item and the list's new ETag. No If-Match:
#     Concurrency:IfMatch defaults to Optional, so an unconditional write is still accepted — see
#     docs/adr/0013. Raises a domain event, published after the commit succeeds.
POST {{api}}/todo-lists/{{todoListId}}/items/{{todoItemId}}/complete
Authorization: Bearer {{accessToken}}

###
# 16. Completing it twice is refused by the aggregate's invariant, surfaced as a 409.
POST {{api}}/todo-lists/{{todoListId}}/items/{{todoItemId}}/complete
Authorization: Bearer {{accessToken}}

###
# 16b. Reopen the item completed by request 15. 200 with the item and the list's new ETag.
POST {{api}}/todo-lists/{{todoListId}}/items/{{todoItemId}}/reopen
Authorization: Bearer {{accessToken}}

###
# 16c. Replace the item's title and description. A PUT carrying the whole representation of the
#      operation, never a PATCH — see docs/adr/0018. A field left out is a field cleared.
PUT {{api}}/todo-lists/{{todoListId}}/items/{{todoItemId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "Buy oat milk",
  "description": "One litre is enough"
}

###
# 16d. Every item of the list, wrapped in an object rather than returned as a bare array so the
#      shape can gain a field later. Not paginated: the aggregate is bounded by TodoList.MaxItems.
#      The ETag is the list's — the list is the aggregate.
GET {{api}}/todo-lists/{{todoListId}}/items
Authorization: Bearer {{accessToken}}

###
# 16e. Add one tag. 200, not 201: adding a tag the item already carries is a no-op in the domain,
#      and there is no GET on a single tag for a Location to name. Send it twice to see that.
POST {{api}}/todo-lists/{{todoListId}}/items/{{todoItemId}}/tags
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "tag": "Urgent"
}

###
# 16f. Replace the whole tag set. Total replacement, not a merge: what is absent is removed. An
#      empty array clears the tags.
PUT {{api}}/todo-lists/{{todoListId}}/items/{{todoItemId}}/tags
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "tags": ["errand", "dairy", "urgent"]
}

###
# 16g. Remove one tag, named in the route and percent-encoded. Removing an absent tag is a no-op,
#      for the same reason as adding a present one. A tag containing a / cannot be addressed this
#      way — %2F is decoded before routing — so remove that one with request 16f instead.
DELETE {{api}}/todo-lists/{{todoListId}}/items/{{todoItemId}}/tags/urgent
Authorization: Bearer {{accessToken}}

###
# 16h. Schedule a reminder for the item. 201, with the reminder and its own ETag — a reminder is
#      versioned independently of the list. Location has no reminder id to name: there is no
#      single-reminder GET, only the per-item list below, so it points there instead.
# @name scheduleReminder
POST {{api}}/todo-lists/{{todoListId}}/items/{{todoItemId}}/reminders
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "dueAt": "2026-12-31T09:00:00Z"
}

###
@reminderId = {{scheduleReminder.response.body.$.id}}
@reminderETag = {{scheduleReminder.response.headers.ETag}}

###
# 16i. Every reminder scheduled for the item, wrapped in an object for the same reason the item
#      list above is. No ETag here: the underlying query answers a plain list with no per-reminder
#      version attached.
GET {{api}}/todo-lists/{{todoListId}}/items/{{todoItemId}}/reminders
Authorization: Bearer {{accessToken}}

###
# 16j. Reschedule it conditionally, naming the version from request 16h. 200, with the rescheduled
#      reminder and the ETag it is now at. Addressed by the reminder's own id, not by list/item —
#      a reminder is its own aggregate root.
PUT {{api}}/reminders/{{reminderId}}
Authorization: Bearer {{accessToken}}
If-Match: {{reminderETag}}
Content-Type: application/json

{
  "dueAt": "2027-01-15T09:00:00Z"
}

###
# 16k. Cancel it. 204: DELETE, not POST .../cancel — cancelling is a one-way terminal transition,
#      the same shape as deleting a resource, and needs no request body.
DELETE {{api}}/reminders/{{reminderId}}
Authorization: Bearer {{accessToken}}

###
# 17. First page of the caller's lists. Only lists the caller owns are visible: ownership is a
#     filter inside the read query, so somebody else's list is 404, never 403.
GET {{api}}/todo-lists?page=1&pageSize=10
Authorization: Bearer {{accessToken}}

###
# 18. An out-of-range page size is a 400 with a ProblemDetails body, not a silent clamp.
GET {{api}}/todo-lists?page=1&pageSize=10000
Authorization: Bearer {{accessToken}}

###
# 19. Sorting. Multi-field, direction per field, over a per-feature whitelist: only `name`,
#     `createdAt` and `lastModifiedAt` are sortable, and `Id` is appended to every ORDER BY as a
#     tiebreaker so two lists created in the same instant cannot swap places between pages.
GET {{api}}/todo-lists?sort=name:asc,createdAt:desc&pageSize=5
Authorization: Bearer {{accessToken}}

###
# 20. A field that is not on the whitelist is refused before a query is built: 400 with
#     "code": "sort.invalid", and the message lists the fields that are allowed. No caller string
#     ever reaches a LINQ expression.
GET {{api}}/todo-lists?sort=ownerId:asc
Authorization: Bearer {{accessToken}}

###
# 21. Filtering. `search` is a case-insensitive contains on the list name, done in the database with
#     ILIKE and with %, _ and \ escaped — so this matches names containing "grocer", not everything.
#     `createdAfter`/`createdBefore` narrow by creation date and are inclusive.
GET {{api}}/todo-lists?search=grocer&createdAfter=2020-01-01T00:00:00Z
Authorization: Bearer {{accessToken}}

###
# 22. Keyset paging, first page. No `page`, and the response carries no `totalCount`: counting the
#     whole match set is a second scan of it, which is the cost this mode exists to avoid.
#     Cursor mode allows one sort term, over a field that is keyset-capable — `lastModifiedAt` is
#     not, because it is nullable.
# @name firstKeysetPage
GET {{api}}/todo-lists?paging=cursor&pageSize=2&sort=createdAt:desc
Authorization: Bearer {{accessToken}}

###
@nextCursor = {{firstKeysetPage.response.body.$.nextCursor}}

###
# 23. Follow `nextCursor` for the next page. Send the SAME `sort` the cursor was minted under: a
#     cursor names the order it came from, and resuming it under a different one is refused with
#     "code": "cursor.invalid" rather than silently serving an incoherent page.
#     When `nextCursor` is null there are no more pages.
GET {{api}}/todo-lists?paging=cursor&pageSize=2&sort=createdAt:desc&cursor={{nextCursor}}
Authorization: Bearer {{accessToken}}

###
# 24. A cursor is only meaningful with paging=cursor. Sending one with offset paging is a 400
#     ("code": "paging.invalid"), never silently ignored.
GET {{api}}/todo-lists?page=1&cursor={{nextCursor}}
Authorization: Bearer {{accessToken}}

###
# 25. Idempotency. POST with an Idempotency-Key; note the id that comes back.
# @name firstCreate
POST {{api}}/todo-lists
Authorization: Bearer {{accessToken}}
Idempotency-Key: 9f1c7e2a-0c1b-4f0a-9a3e-2b6d5c4a8e10
Content-Type: application/json

{
  "name": "Paid once"
}

###
# 26. Replay request 25 byte for byte — the retry a flaky network causes. Same status, same body,
#     same Location, plus "Idempotency-Replayed: true", and NO second list is created.
POST {{api}}/todo-lists
Authorization: Bearer {{accessToken}}
Idempotency-Key: 9f1c7e2a-0c1b-4f0a-9a3e-2b6d5c4a8e10
Content-Type: application/json

{
  "name": "Paid once"
}

###
# 27. The same key with a DIFFERENT body is a 409 ("code": "idempotency.keyReused"). A key stands
#     for one request, not for one caller — reusing it for something else is a client bug worth
#     reporting rather than quietly honouring.
POST {{api}}/todo-lists
Authorization: Bearer {{accessToken}}
Idempotency-Key: 9f1c7e2a-0c1b-4f0a-9a3e-2b6d5c4a8e10
Content-Type: application/json

{
  "name": "Something else entirely"
}

###
# 28. Clean up the list created by request 25.
DELETE {{api}}/todo-lists/{{firstCreate.response.body.$.id}}
Authorization: Bearer {{accessToken}}

###
# 29. Remove the item. 200 with the LIST, not the item: the item this route addresses no longer
#     exists, so the list is the only representation left — and the only ETag left to write against.
DELETE {{api}}/todo-lists/{{todoListId}}/items/{{todoItemId}}
Authorization: Bearer {{accessToken}}

###
# 30. Rotate the token pair. The presented refresh token is always revoked; replaying one that was
#     already used revokes the whole family for that user.
# @name refresh
POST {{api}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

###
@rotatedRefreshToken = {{refresh.response.body.$.refreshToken}}

###
# 31. Replay the token consumed by request 30: 401, and every refresh token in that family is now
#     revoked. Run request 30 again afterwards to see the rotated one rejected too.
POST {{api}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

###
# 32. Delete the list. Cascades to its items. No If-Match, accepted for the same reason as request 15.
DELETE {{api}}/todo-lists/{{todoListId}}
Authorization: Bearer {{accessToken}}

###
# 33. Log out, revoking the refresh token from request 30.
POST {{api}}/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{rotatedRefreshToken}}"
}

###
# 33a. Log out everywhere: revokes every refresh token grant for the account, not just one. 204,
#      and no count in the body — it would tell the caller about other live sessions with nothing
#      it can do about them. The access token used here keeps working: only refresh tokens are
#      revoked, so the session that made this call is not the one it signs out.
POST {{api}}/auth/logout-all
Authorization: Bearer {{accessToken}}

###
# 33b. Change the password. Authenticated, and the current password is presented again as proof the
#      session is not a stolen token. Every refresh token for the account is revoked, so the tokens
#      captured above stop working — sign in again before running anything below that needs one.
POST {{api}}/auth/change-password
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "currentPassword": "{{password}}",
  "newPassword": "{{newPassword}}"
}

###
# 33c. Start a password reset. 204 for every well-formed address, registered or not: the response
#      must not tell a caller which addresses exist. The token arrives by mail — read it out of
#      mailpit the same way as request 4.
POST {{api}}/auth/forgot-password
Content-Type: application/json

{
  "email": "{{email}}"
}

###
# Paste the token from the reset mail here.
@resetToken = paste-the-token-from-request-33c

###
# 33d. Finish the reset. POST with a JSON body for the same reason as confirm-email: a single-use
#      token must not land in access logs, browser history or a Referer header.
POST {{api}}/auth/reset-password
Content-Type: application/json

{
  "email": "{{email}}",
  "token": "{{resetToken}}",
  "newPassword": "{{resetPassword}}"
}

###
# 34. Liveness. No dependency is checked, so an orchestrator does not restart the API because the
#     database blinked. Anonymous by design.
GET {{host}}/health

###
# 35. Readiness. Checks the database, and is what a load balancer should poll.
GET {{host}}/health/ready

###
# 36. Rate limiting. The auth policy allows 10 requests per minute per client address; run this
#     block repeatedly to get a 429 carrying Retry-After and a ProblemDetails body.
#     Behind a proxy this partitions correctly only when ReverseProxy:Enabled is configured —
#     otherwise every caller shares the proxy's single window. See SECURITY.md.
POST {{api}}/auth/login
Content-Type: application/json

{
  "email": "nobody@localhost",
  "password": "wrong-password"
}

###
# 37. Maintenance. Both purges answer 200 with {"deleted": n} — an object rather than a bare number,
#     so a second field can be added without breaking callers. A scheduled job (a Kubernetes CronJob,
#     a cloud scheduler) is expected to call these; the cadence is a deployment concern.
#
#     Expected to fail with the walkthrough account: these require the Administrator role, and
#     registration does not grant it. Grant it in the database, or read this as documentation of the
#     403 that default-deny produces.
DELETE {{api}}/maintenance/idempotency-keys/expired
Authorization: Bearer {{accessToken}}

###
# 38. The same, for refresh-token grants. The table only grows — one row per rotation — until an
#     operator prunes it, which is why the endpoint exists at all.
DELETE {{api}}/maintenance/refresh-tokens/expired
Authorization: Bearer {{accessToken}}
