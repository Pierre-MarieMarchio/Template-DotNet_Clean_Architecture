<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests for the identity module's own decisions: how a refresh token is rotated, what a failure
       is allowed to disclose, how an account email is encoded, and what the options validators
       refuse.

       Most of it needs no infrastructure — the collaborators are ports and the decisions are the
       module's own. One class is the exception, and deliberately so: single-use rotation under
       concurrency is a guarantee the *database* makes, so asserting it against a fake store would
       only assert that the fake was written to agree. That class runs against a real PostgreSQL in a
       container and races two presentations of the same token.

       The identity module's types are internal apart from IdentityModule, so this project holds
       InternalsVisibleTo from it. It needs none from AppTemplate.Infrastructure.Persistence: the grant store
       is reached through the public IRefreshTokenStore, exactly as the module reaches it, and rows
       are inspected over the context's own connection. -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- The module composes ASP.NET Core Identity, so the tests need the same shared framework the
       host runs on. It also supplies the configuration, options, logging and DI abstractions used
       here, which is why there is no PackageReference for any of them — NuGet rejects one as
       redundant (NU1510). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Src\Infrastructure\AppTemplate.Infrastructure.Identity\AppTemplate.Infrastructure.Identity.csproj" />
  </ItemGroup>

</Project>
