<Project Sdk="Microsoft.NET.Sdk">

  <!-- End-to-end tests for the API. Almost every test drives the real host over HTTP against a real
       PostgreSQL instance in a container: the only substituted adapters are the ones that reach
       outside the process, and both of those come from AppTemplate.Infrastructure.InMemory rather than
       from a fake defined here. Nothing in this project knows an internal type of a module. -->
  <!--#if (files)-->

  <!-- Storage/ is the one exception to "over HTTP against the host", and it is here rather than in a
       project of its own because a test project is one more entry in AppTemplate.sln and
       one more GUID to keep in step.
       Of the two integration projects this is the one that already references
       AppTemplate.Infrastructure.Storage, and the one whose name promises a layer rather than a
       single module — so the S3 adapters are exercised through their ports here, against a real
       S3 store, with no reference added anywhere that would make a project name a lie. -->
  <!--#endif-->


  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Shouldly" />
    <!--#if (files)-->
    <!-- The object store the Storage/ suite talks to. Same SeaweedFS image the development stack
         runs, so what those tests exercise is the store a developer already has in front of them. -->
    <PackageReference Include="Testcontainers" />
    <!--#endif-->
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <!-- The API under test, plus the module that supplies the recording doubles. The API
       deliberately does not reference AppTemplate.Infrastructure.InMemory, so the test host is the only
       thing that composes both. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\Src\Presentation\AppTemplate.Api\AppTemplate.Api.csproj" />
    <ProjectReference Include="..\..\..\Src\Infrastructure\AppTemplate.Infrastructure.InMemory\AppTemplate.Infrastructure.InMemory.csproj" />
    <!--#if (files)-->
    <ProjectReference Include="..\..\..\Src\Infrastructure\AppTemplate.Infrastructure.Storage\AppTemplate.Infrastructure.Storage.csproj" />
    <!--#endif-->
  </ItemGroup>

</Project>
